# DB 接続は Rails credentials（db.*）に書く。bin/rails credentials:edit
# テンプレート: config/credentials/db.example.yml
# 詳細: docs/architecture/database.adoc
#
# 本番では RAILS_MASTER_KEY のみ .env.production に置く（DB パスワードは credentials 内）。
# KBMEMO_APP_HOST=kbmemo.example.com
# KBMEMO_SESSION_COOKIE_DOMAIN=.kbmemo.example.com
#
# Tsuzura — 開発既定は http://localhost:3008（kbmemo-media を起動）。本番向けは development では設定しない。
# TSUZURA_PUBLIC_URL=http://localhost:3008
# TSUZURA_BASE_URL=http://localhost:3008
# KBMEMO_TSUZURA_INTERNAL_SECRET=  # credentials :tsuzura :internal_secret と同一
#
# 開発中だけ本番 media を使う場合（通常不要）:
# TSUZURA_PUBLIC_URL=https://media.example.com
# TSUZURA_BASE_URL=https://media.example.com
#
# Nyoy memo RAG webhook — 有効化時のみ、メモ作成/更新/削除を Nyoy へ通知する。
# NYOY_MEMO_WEBHOOK_ENABLED=true
# NYOY_MEMO_WEBHOOK_URL=http://localhost:3109/webhooks/kbmemo/memos
# NYOY_MEMO_WEBHOOK_SECRET=change-me

#!/usr/bin/env ruby
# frozen_string_literal: true

APP_ROOT = File.expand_path("..", __dir__)

def load_env_file(path)
  return unless File.exist?(path)

  File.foreach(path, chomp: true) do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")

    key, value = line.split("=", 2)
    next if key.nil? || value.nil?

    ENV[key] = value.delete_prefix('"').delete_suffix('"')
  end
end

load_env_file(File.join(APP_ROOT, ".env.development"))

COMMANDS = [
  ["vite", "./bin/vite", "dev"],
  ["web", "./bin/rails", "server"],
].freeze

Dir.chdir(APP_ROOT) do
  pids = {}
  stopping = false

  stop_children = lambda do
    next if stopping

    stopping = true
    pids.each_value do |pid|
      begin
        Process.kill("TERM", pid)
      rescue Errno::ESRCH
      end
    end
  end

  Signal.trap("INT") { stop_children.call }
  Signal.trap("TERM") { stop_children.call }

  COMMANDS.each do |name, *command|
    command += ARGV if name == "web"
    pids[name] = spawn(*command)
  end

  status = nil
  begin
    _pid, status = Process.wait2
  rescue Errno::ECHILD
  ensure
    stop_children.call
    pids.each_value do |pid|
      begin
        Process.wait(pid)
      rescue Errno::ECHILD
      end
    end
  end

  exit(status&.signaled? ? 128 + status.termsig : status&.exitstatus || 0)
end

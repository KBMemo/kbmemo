#!/usr/bin/env bash
set -euo pipefail

APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

SYSTEMD_UNIT=""
GIT_REMOTE=""
GIT_BRANCH=""
SKIP_PULL=0
SKIP_RESTART=0
DRY_RUN=0

usage() {
  cat <<'EOF'
Usage: bin/deploy [options]

Pull the latest code, install dependencies, migrate, precompile assets,
and restart the kbmemo systemd user service (production server).

Options:
  -b, --branch BRANCH   git fetch/pull this branch (default: current branch)
  --skip-pull           skip git pull
  --skip-restart        skip systemctl restart and health check
  -n, --dry-run         print commands without running them
  -h, --help            show this help

Environment:
  KBMEMO_SYSTEMD_UNIT   systemd unit name (default: kbmemo)
  KBMEMO_HEALTH_URL     health check URL (default: http://127.0.0.1:$PORT/up)
  KBMEMO_HEALTH_HOST    optional Host header for a localhost health check
  KBMEMO_HEALTH_CHECK_DELAY
                        seconds to wait before first health check (default: 3)
  KBMEMO_GIT_REMOTE     git remote (default: origin)

Example:
  cd /srv/kbmemo/site && bin/deploy
  bin/deploy --branch main
EOF
}

run() {
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    printf '+'
    printf ' %q' "$@"
    printf '\n'
    return 0
  fi
  "$@"
}

step() {
  echo "==> $*"
}

health_check() {
  local url="$1"
  local host_header="${KBMEMO_HEALTH_HOST:-}"

  if [[ -n "${host_header}" ]]; then
    curl -fsS -H "Host: ${host_header}" "${url}"
  else
    curl -fsS "${url}"
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -b|--branch)
      GIT_BRANCH="${2:?missing branch name}"
      shift 2
      ;;
    --skip-pull)
      SKIP_PULL=1
      shift
      ;;
    --skip-restart)
      SKIP_RESTART=1
      shift
      ;;
    -n|--dry-run)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

# shellcheck source=scripts/production_env.sh
source "${APP_ROOT}/scripts/production_env.sh"

SYSTEMD_UNIT="${KBMEMO_SYSTEMD_UNIT:-kbmemo}"
GIT_REMOTE="${KBMEMO_GIT_REMOTE:-origin}"
PORT="${PORT:-3007}"
HEALTH_URL="${KBMEMO_HEALTH_URL:-http://127.0.0.1:${PORT}/up}"
HEALTH_CHECK_DELAY="${KBMEMO_HEALTH_CHECK_DELAY:-3}"

if [[ ! "${HEALTH_CHECK_DELAY}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  echo "KBMEMO_HEALTH_CHECK_DELAY must be a non-negative number" >&2
  exit 1
fi

step "deploy kbmemo (${APP_ROOT}, RAILS_ENV=${RAILS_ENV})"

if [[ "${SKIP_PULL}" -eq 0 ]]; then
  step "git pull"
  if [[ -n "${GIT_BRANCH}" ]]; then
    run git fetch "${GIT_REMOTE}" "${GIT_BRANCH}"
    run git checkout "${GIT_BRANCH}"
    run git pull --ff-only "${GIT_REMOTE}" "${GIT_BRANCH}"
  else
    run git pull --ff-only "${GIT_REMOTE}"
  fi
fi

step "bundle install"
run bundle install

step "npm ci"
run npm ci

step "db:migrate"
run bundle exec rails db:migrate

step "assets:precompile"
run bundle exec vite build --force
run bundle exec rails assets:precompile

if [[ -f "${APP_ROOT}/start.sh" ]]; then
  step "ensure start.sh is executable"
  run chmod 750 "${APP_ROOT}/start.sh"
fi

if [[ "${SKIP_RESTART}" -eq 0 ]]; then
  step "restart ${SYSTEMD_UNIT}"
  run systemctl --user restart "${SYSTEMD_UNIT}"

  step "wait ${HEALTH_CHECK_DELAY}s for startup"
  run sleep "${HEALTH_CHECK_DELAY}"

  step "health check ${HEALTH_URL}"
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    run health_check "${HEALTH_URL}"
  else
    for attempt in 1 2 3 4 5; do
      if health_check "${HEALTH_URL}" >/dev/null; then
        echo "health check OK"
        break
      fi
      if [[ "${attempt}" -eq 5 ]]; then
        echo "health check failed after restart: ${HEALTH_URL}" >&2
        echo "check: journalctl --user -u ${SYSTEMD_UNIT} -n 50 --no-pager" >&2
        exit 1
      fi
      sleep 2
    done
  fi
fi

step "deploy finished"

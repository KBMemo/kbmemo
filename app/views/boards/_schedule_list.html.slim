.kb-board-schedule-list.flex.min-h-0.flex-1.flex-col.overflow-hidden.px-3.py-3
  .mb-2.flex.items-center.justify-between.gap-2
    h2.text-xs.font-medium.uppercase.tracking-wide.kb-text-muted 予定
    - if calendar.week_view?
      .flex.min-w-0.items-center.gap-1
        = link_to "‹", board_schedule_week_path(board, calendar.prev_week_day), class: "kb-chrome-btn-secondary inline-flex h-6 w-6 shrink-0 items-center justify-center p-0 text-xs", title: "前の週", data: { turbo_frame: "board_schedule_panel" }
        p.truncate.text-xs.kb-text-secondary = board_schedule_list_heading(calendar)
        = link_to "›", board_schedule_week_path(board, calendar.next_week_day), class: "kb-chrome-btn-secondary inline-flex h-6 w-6 shrink-0 items-center justify-center p-0 text-xs", title: "次の週", data: { turbo_frame: "board_schedule_panel" }
    - else
      p.text-xs.kb-text-secondary = board_schedule_list_heading(calendar)
  .min-h-0.flex-1.overflow-y-auto
    - if calendar.day_view?
      - if calendar.list_items.any?
        ul.space-y-2
          - calendar.list_items.each do |memo|
            = render "boards/schedule_memo_item", memo: memo
      - else
        p.text-sm.kb-text-muted この日の予定はありません。
        p.mt-1.text-xs.kb-text-subtle カンバンカードの予定日や Google Calendar から取り込んだ予定がここに表示されます。
    - elsif calendar.list_groups.any?
      .space-y-3
        - calendar.list_groups.each do |group|
          section
            p class="mb-1 text-[11px] font-medium kb-text-muted" = l(group[:date], format: :long)
            ul.space-y-2
              - group[:memos].each do |memo|
                = render "boards/schedule_memo_item", memo: memo
    - else
      - empty_message = calendar.week_view? ? "この週の予定はありません。" : "この月の予定はありません。"
      p.text-sm.kb-text-muted = empty_message
      p.mt-1.text-xs.kb-text-subtle カンバンカードの予定日や Google Calendar から取り込んだ予定がここに表示されます。

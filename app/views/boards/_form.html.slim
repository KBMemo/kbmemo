= form_with model: board, class: "space-y-4 max-w-xl" do |f|
  - if board.errors.any?
    .rounded-md.border.border-red-200.bg-red-50.px-3.py-2.text-sm.text-red-900
      ul.list-disc.pl-5
        - board.errors.full_messages.each do |message|
          li = message

  div
    = f.label :title, "ボード名", class: "#{kb_label} mb-1"
    = f.text_field :title, required: true, class: kb_field_input_classes

  div
    = f.label :memo_directory_id, "新規カードの保存先ディレクトリ", class: "#{kb_label} mb-1"
    = f.collection_select :memo_directory_id, @memo_directory_options, :id, :label, { include_blank: "デフォルト（home/u-{id}）" }, class: kb_field_input_classes
    p.mt-1.text-xs.kb-text-muted ボード上から新規メモを作るときの Git 配置先です。

  .flex.flex-wrap.items-center.gap-3
    = f.submit submit_label, class: "kb-chrome-btn-primary px-4 py-2", data: { theme_slot: "btn-primary" }
    - if board.persisted?
      = link_to "キャンセル", board_path(board), class: "kb-chrome-link text-sm"
    - else
      = link_to "キャンセル", boards_path, class: "kb-chrome-link text-sm"

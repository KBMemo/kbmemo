= form_with model: board, class: "space-y-4 max-w-xl" do |f|
  - if board.errors.any?
    .kb-alert.kb-alert-danger
      ul.list-disc.pl-5
        - board.errors.full_messages.each do |message|
          li = message

  div
    = f.label :title, "ボード名", class: "#{kb_label} mb-1"
    = f.text_field :title, required: true, class: kb_field_input_classes, aria: kb_field_error_aria(board, :title)
    - if kb_field_error?(board, :title)
      p.mt-1.text-sm.kb-status-danger id=kb_field_error_id(board, :title) = kb_field_error_message(board, :title)

  .flex.flex-wrap.items-center.gap-3
    = f.submit submit_label, class: "kb-chrome-btn-primary kb-btn-md", data: { theme_slot: "btn-primary" }
    - if board.persisted?
      = link_to "キャンセル", board_path(board), class: "kb-chrome-link text-sm"
    - else
      = link_to "キャンセル", boards_path, class: "kb-chrome-link text-sm"

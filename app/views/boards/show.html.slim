- content_for :title, @board.title

div[data-controller="board-add-memo" data-board-add-memo-search-url-value=available_memos_board_path(@board) data-board-add-memo-create-url-value=board_board_cards_path(@board) data-board-add-memo-default-column-id-value=@board_columns.first&.id]
  .mb-4.flex.flex-wrap.items-start.justify-between.gap-3
    div
      h1.text-xl.font-semibold.text-zinc-900 = @board.title
      p.mt-1.text-sm.text-zinc-600
        = link_to "ボード一覧", boards_path, class: "text-zinc-600 hover:text-zinc-900"
        = " · "
        = link_to "設定", edit_board_path(@board), class: "text-zinc-600 hover:text-zinc-900"
    .flex.flex-wrap.items-center.gap-2
      button.rounded-md.border.border-zinc-300.bg-white.px-3.py-1.5.text-sm.font-medium.text-zinc-800.hover:bg-zinc-50[type="button" data-action="board-add-memo#open"] 既存メモを追加
      = form_with url: board_board_cards_path(@board), method: :post, class: "flex items-center gap-2", data: { turbo: true } do |f|
        = hidden_field_tag :kanban_column_id, @board_columns.first&.id
        = text_field_tag :title, nil, placeholder: "新規カードのタイトル", required: true, class: "w-48 rounded-md border border-zinc-300 px-2 py-1.5 text-sm sm:w-64"
        = submit_tag "追加", class: "rounded-md bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-zinc-800"

  #board_add_memo_panel.hidden.fixed.inset-0.z-40[data-board-add-memo-target="panel"]
    .absolute.inset-0.bg-zinc-900/40[data-action="click->board-add-memo#close"]
    div class="absolute left-1/2 top-[10vh] -translate-x-1/2 w-[min(96vw,32rem)] rounded-lg border border-zinc-200 bg-white shadow-xl"
      .flex.items-center.justify-between.border-b.border-zinc-200.px-4.py-3
        h2.text-base.font-semibold.text-zinc-900 既存メモを追加
        button.text-zinc-500.hover:text-zinc-800[type="button" data-action="board-add-memo#close" aria-label="閉じる"] ×
      .space-y-3.p-4
        = text_field_tag :q, nil, placeholder: "タイトル・本文で検索", class: "w-full rounded-md border border-zinc-300 px-3 py-2 text-sm", data: { board_add_memo_target: "query", action: "input->board-add-memo#search" }
        .max-h-64.overflow-y-auto.rounded-md.border.border-zinc-200[data-board-add-memo-target="results"]
          p.px-3.py-2.text-sm.text-zinc-500 検索してください

  = render "kanban", board: @board, board_columns: @board_columns, visible_memo_ids: @visible_memo_ids

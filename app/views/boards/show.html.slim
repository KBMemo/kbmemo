- content_for :title, @board.title

div class="kb-chrome-workspace flex -mx-4 flex-col border-t md:min-h-[calc(100vh-6.75rem)] md:flex-row md:items-start" data-controller="memo-sidebar board-add-memo" data-memo-sidebar-storage-key-value="kbmemo_board_schedule_sidebar_v1" data-board-add-memo-search-url-value=available_memos_board_path(@board) data-board-add-memo-create-url-value=board_board_cards_path(@board) data-board-add-memo-default-column-id-value=@board_columns.first&.id
  #board_schedule_sidebar_shell.kb-chrome-panel class="flex max-md:w-full flex-shrink-0 flex-col border-b transition-[width] duration-200 ease-out md:h-auto md:max-h-[calc(100vh-6.75rem)] md:self-start md:flex-shrink-0 md:border-b-0 md:border-r md:border-t-0" data-theme-slot="memo-sidebar" data-memo-sidebar-target="shell"
    button.kb-chrome-muted-bar.flex.w-full.shrink-0.items-center.justify-center.gap-2.border-b.px-2.py-2.text-left.text-xs.font-medium.md:hidden type="button" data-memo-sidebar-target="toggleButtonMobile" data-action="memo-sidebar#toggle" aria-expanded="true" aria-controls="board_schedule_panel"
      span.text-sm.leading-none.tabular-nums aria-hidden="true" data-memo-sidebar-target="toggleGlyphMobile" ◀
      span.sr-only 予定サイドバー
      span data-memo-sidebar-target="toggleLabelMobile" 折りたたむ
    .flex.min-h-0.flex-1.flex-col data-memo-sidebar-target="body"
      = render "boards/schedule_sidebar", board: @board, schedule_calendar: @schedule_calendar
  button class=kb_sidebar_toggle_btn type="button" data-memo-sidebar-target="toggleButton" data-action="memo-sidebar#toggle" aria-expanded="true" aria-controls="board_schedule_panel" title="予定サイドバーを折りたたむ"
    span.select-none.tracking-tighter aria-hidden="true" data-memo-sidebar-target="toggleGlyph" ««
    span.sr-only 予定サイドバー
  div class=kb_resizer role="separator" aria-orientation="vertical" aria-label="サイドバーの幅を変更" title="ドラッグして幅を変更" tabindex="-1" data-memo-sidebar-target="resizer" data-action="pointerdown->memo-sidebar#resizerPointerDown"
  section.flex.min-w-0.flex-1.flex-col
    div.px-4.py-5.md:px-8
      .mb-4.flex.flex-wrap.items-start.justify-between.gap-3
        div
          h1.text-xl.font-semibold.kb-text-primary = @board.title
          p.mt-1.text-sm.kb-text-secondary
            = link_to "ボード一覧", boards_path, class: "kb-chrome-link"
            = " · "
            = link_to "設定", edit_board_path(@board), class: "kb-chrome-link"
        .flex.flex-wrap.items-center.gap-2
          button.kb-chrome-btn-secondary.kb-btn-md type="button" data-action="board-add-memo#open" 既存メモを追加
          = form_with url: board_board_cards_path(@board), method: :post, class: "flex items-center gap-2", data: { turbo: true } do |f|
            = hidden_field_tag :kanban_column_id, @board_columns.first&.id
            = text_field_tag :title, nil, placeholder: "新規カードのタイトル", required: true, class: "kb-input kb-input-sm w-48 sm:w-64"
            = submit_tag "追加", class: "kb-chrome-btn-primary kb-btn-md", data: { theme_slot: "btn-primary" }

      #board_add_memo_panel.hidden.fixed.inset-0.z-40 data-board-add-memo-target="panel"
        .kb-overlay-backdrop.absolute.inset-0 data-action="click->board-add-memo#close"
        div class="kb-modal-panel absolute left-1/2 top-[10vh] -translate-x-1/2 w-[min(96vw,32rem)] rounded-lg"
          .flex.items-center.justify-between.border-b.kb-border.px-4.py-3
            h2.text-base.font-semibold.kb-text-primary 既存メモを追加
            button.kb-text-muted.hover:opacity-80 type="button" data-action="board-add-memo#close" aria-label="閉じる" ×
          .space-y-3.p-4
            = text_field_tag :q, nil, placeholder: "タイトル・本文で検索", class: "kb-input kb-input-md w-full", data: { board_add_memo_target: "query", action: "input->board-add-memo#search" }
            .max-h-64.overflow-y-auto.rounded-md.border.kb-border data-board-add-memo-target="results"
              p.px-3.py-2.text-sm.kb-text-secondary 検索してください

      = render "kanban", board: @board, board_columns: @board_columns, visible_memo_ids: @visible_memo_ids

- content_for :title, @board.title

div[data-controller="board-add-memo" data-board-add-memo-search-url-value=available_memos_board_path(@board) data-board-add-memo-create-url-value=board_board_cards_path(@board) data-board-add-memo-default-column-id-value=@board_columns.first&.id]
  .mb-4.flex.flex-wrap.items-start.justify-between.gap-3
    div
      h1.text-xl.font-semibold.kb-text-primary = @board.title
      p.mt-1.text-sm.kb-text-secondary
        = link_to "ボード一覧", boards_path, class: "kb-chrome-link"
        = " · "
        = link_to "設定", edit_board_path(@board), class: "kb-chrome-link"
    .flex.flex-wrap.items-center.gap-2
      button.kb-chrome-btn-secondary type="button" data-action="board-add-memo#open" 既存メモを追加
      = form_with url: board_board_cards_path(@board), method: :post, class: "flex items-center gap-2", data: { turbo: true } do |f|
        = hidden_field_tag :kanban_column_id, @board_columns.first&.id
        = text_field_tag :title, nil, placeholder: "新規カードのタイトル", required: true, class: "kb-input w-48 rounded-md px-2 py-1.5 text-sm sm:w-64"
        = submit_tag "追加", class: "kb-chrome-btn-primary", data: { theme_slot: "btn-primary" }

  #board_add_memo_panel.hidden.fixed.inset-0.z-40[data-board-add-memo-target="panel"]
    .kb-overlay-backdrop.absolute.inset-0[data-action="click->board-add-memo#close"]
    div class="kb-modal-panel absolute left-1/2 top-[10vh] -translate-x-1/2 w-[min(96vw,32rem)] rounded-lg"
      .flex.items-center.justify-between.border-b.kb-border.px-4.py-3
        h2.text-base.font-semibold.kb-text-primary 既存メモを追加
        button.kb-text-muted.hover:opacity-80 type="button" data-action="board-add-memo#close" aria-label="閉じる" ×
      .space-y-3.p-4
        = text_field_tag :q, nil, placeholder: "タイトル・本文で検索", class: "kb-input w-full rounded-md px-3 py-2 text-sm", data: { board_add_memo_target: "query", action: "input->board-add-memo#search" }
        .max-h-64.overflow-y-auto.rounded-md.border.kb-border[data-board-add-memo-target="results"]
          p.px-3.py-2.text-sm.kb-text-secondary 検索してください

  = render "kanban", board: @board, board_columns: @board_columns, visible_memo_ids: @visible_memo_ids

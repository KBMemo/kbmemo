- content_for :title, "ボード編集"

.mb-6
  h1 class=kb_page_title ボード編集
  p.mt-1.text-sm.kb-text-secondary = @board.title

= render "form", board: @board, submit_label: "更新"

.mt-8.border-t.kb-border.pt-6
  h2 class=kb_section_title 列（3 列固定）
  p.mb-4.text-sm.kb-text-secondary 列名の変更と左右の入れ替えができます。
  .space-y-3
    - @board_columns.each_with_index do |column, index|
      .kb-card.flex.flex-wrap.items-center.gap-3.px-3.py-2
        span.text-xs.font-medium.uppercase.kb-text-muted = "列 #{index + 1}"
        = form_with model: column, url: board_board_column_path(@board, column), method: :patch, class: "flex min-w-0 flex-1 flex-wrap items-center gap-2" do |f|
          = f.text_field :name, class: "kb-input kb-input-sm min-w-[8rem] flex-1"
          = f.submit "名前を保存", class: "kb-chrome-btn-secondary kb-btn-xs"
        .flex.items-center.gap-1
          - if index.positive?
            = button_to "←", swap_board_board_column_path(@board, column, other_column_id: @board_columns[index - 1].id), method: :post, class: "kb-toolbar-btn", title: "左へ"
          - if index < @board_columns.size - 1
            = button_to "→", swap_board_board_column_path(@board, column, other_column_id: @board_columns[index + 1].id), method: :post, class: "kb-toolbar-btn", title: "右へ"

.mt-4
  = link_to "カンバンに戻る", board_path(@board), class: "kb-chrome-link text-sm"

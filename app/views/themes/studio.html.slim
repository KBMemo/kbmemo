- content_for :title, "テーマ作成"

div data-controller="theme-studio" data-theme-studio-editing-theme-id-value=(@editing_theme_id || "") data-theme-studio-token-filter-value="all"
  .mb-6
    h1.text-2xl.font-semibold.kb-text-primary テーマ作成
    p.mt-2.text-sm.kb-text-secondary
      | 表示・編集・カンバンのサンプルで見た目を確認し、Design モードで要素をクリックして CSS 変数を調整できます。
      | AsciiDoc は asciidoctor-skins 互換の YAML（primarycolor 等）のインポート／エクスポートに対応しています。

  .theme-studio-layout
    aside.theme-studio-sidebar.space-y-4
      div
        label.block.text-sm.font-medium.kb-text-primary for="theme_name" テーマ名
        input#theme_name class="#{kb_field_input_classes} mt-1 w-full rounded px-2 py-1" type="text" value="新しいテーマ" data-theme-studio-target="themeName" data-action="input->theme-studio#themeNameChanged"

      div
        label.block.text-sm.font-medium.kb-text-primary for="theme_base" ベーステーマ
        select#theme_base class="#{kb_field_input_classes} mt-1 w-full rounded px-2 py-1" data-theme-studio-target="baseTheme" data-action="change->theme-studio#baseThemeChanged"
          option value="default" Default
          option value="dark" Dark
          option value="sepia" Sepia
          option value="minimal" Minimal

      div
        label.block.text-sm.font-medium.kb-text-primary for="adoc_preset" AsciiDoc プリセット
        select#adoc_preset class="#{kb_field_input_classes} mt-1 w-full rounded px-2 py-1" data-theme-studio-target="adocPreset" data-action="change->theme-studio#adocPresetChanged"
          option value="" （プリセットなし）

      div
        .flex.items-center.justify-between.gap-2
          p.text-sm.font-medium.kb-text-primary CSS 変数
          .theme-studio-filter-tabs data-theme-studio-target="tokenFilterTabs"
            button.theme-studio-filter-tab.is-active type="button" data-filter="all" data-action="theme-studio#selectTokenFilter" すべて
            button.theme-studio-filter-tab type="button" data-filter="chrome" data-action="theme-studio#selectTokenFilter" UI
            button.theme-studio-filter-tab type="button" data-filter="adoc" data-action="theme-studio#selectTokenFilter" AsciiDoc
        .mt-2.max-h-72.space-y-3.overflow-y-auto data-theme-studio-target="tokenList"

      div
        p.text-sm.font-medium.kb-text-primary 保存済みカスタムテーマ
        ul.mt-2.space-y-1 data-theme-studio-target="customThemeList"

      div.border-t.kb-border.pt-4 data-controller="skin-studio"
        p.text-sm.font-medium.kb-text-primary 本文スキン
        p.mt-1.text-xs.kb-text-muted
          | chrome テーマと独立にメモ本文へ適用されます。カスタムは
          code.mx-1 .memo-body
          | 配下に CSS を書いてください。
        select class="#{kb_field_input_classes} mt-2 w-full rounded px-2 py-1" data-skin-select="true" data-skin-studio-target="select" data-action="change->skin-studio#applySelected" aria-label="本文スキン"
        .mt-3.space-y-2
          input class="#{kb_field_input_classes} w-full rounded px-2 py-1" type="text" placeholder="カスタムスキン名" data-skin-studio-target="name"
          textarea class="#{kb_field_input_classes} w-full rounded px-2 py-1 font-mono text-xs" rows=6 placeholder=".memo-body { ... }" data-skin-studio-target="css"
          .flex.flex-wrap.gap-2
            button.kb-chrome-btn-primary type="button" data-theme-slot="btn-primary" data-action="skin-studio#saveCustom" 保存して適用
            button.kb-chrome-btn-secondary type="button" data-action="skin-studio#newCustom" 新規
        p.mt-3.text-sm.font-medium.kb-text-primary 保存済みカスタムスキン
        ul.mt-2.space-y-1 data-skin-studio-target="customList"
        p.mt-2.text-xs.kb-text-muted data-skin-studio-target="status"

      .flex.flex-wrap.gap-2
        button.kb-chrome-btn-primary type="button" data-theme-slot="btn-primary" data-action="theme-studio#saveTheme" 保存
        button.kb-chrome-btn-secondary type="button" data-action="theme-studio#applyTheme" 適用
        button.kb-chrome-btn-secondary type="button" data-action="theme-studio#newTheme" 新規
        button.kb-chrome-btn-secondary type="button" data-action="theme-studio#exportTheme" JSON
        button.kb-chrome-btn-secondary type="button" data-action="theme-studio#exportYaml" YAML
        button.kb-chrome-btn-secondary type="button" data-action="theme-studio#triggerImport" インポート
        input.hidden type="file" accept="application/json,.json,application/x-yaml,text/yaml,text/x-yaml,.yml,.yaml" data-theme-studio-target="importFile" data-action="change->theme-studio#importTheme"

      p.text-xs.kb-text-muted data-theme-studio-target="status"

    div.theme-studio-main
      .theme-studio-preview
        .theme-studio-preview-toolbar
          button.theme-studio-tab.is-active type="button" data-sample-name="show" data-action="theme-studio#selectSample" 表示
          button.theme-studio-tab type="button" data-sample-name="edit" data-action="theme-studio#selectSample" 編集
          button.theme-studio-tab type="button" data-sample-name="kanban" data-action="theme-studio#selectSample" カンバン
          button.ml-auto.rounded.border.border-blue-300.bg-blue-50.px-3.py-1.text-sm.font-medium.text-blue-800.hover:bg-blue-100 type="button" data-theme-studio-target="designToggle" data-action="theme-studio#toggleDesignMode" aria-pressed="false" Design モード: OFF

        .theme-studio-preview-body
          .theme-studio-highlight hidden="" data-theme-studio-target="highlight"
          div data-theme-studio-target="samplePanel" data-sample-name="show" data-theme-studio-sample="" data-action="click->theme-studio#sampleClick mouseover->theme-studio#sampleMouseOver mouseout->theme-studio#sampleMouseOut"
            = render "themes/sample_show"
          div hidden="" data-theme-studio-target="samplePanel" data-sample-name="edit" data-theme-studio-sample="" data-action="click->theme-studio#sampleClick mouseover->theme-studio#sampleMouseOver mouseout->theme-studio#sampleMouseOut"
            = render "themes/sample_edit"
          div hidden="" data-theme-studio-target="samplePanel" data-sample-name="kanban" data-theme-studio-sample="" data-action="click->theme-studio#sampleClick mouseover->theme-studio#sampleMouseOver mouseout->theme-studio#sampleMouseOut"
            = render "themes/sample_kanban"

      .theme-studio-inspector
        p.text-sm.font-medium.kb-text-primary 選択中の要素
        p.mt-1.theme-studio-selected-label data-theme-studio-target="selectorLabel" 要素をクリックして選択
        .mt-3.space-y-2 data-theme-studio-target="propertyFields"

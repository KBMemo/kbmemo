- content_for :title, "ダイアグラム編集 · #{@memo.title}"
- diagram_key = params[:diagram_key]
- asciidoc = MemoDiagram.asciidoc_for(@source_relative)

div.w-full
  .flex.flex-wrap.items-start.justify-between.gap-2
    div
      h1.text-lg.font-semibold.kb-text-primary ダイアグラム編集
      p.mt-1.text-sm.kb-text-secondary
        | #{@engine} ·
        code.kb-text-secondary= @source_relative
    .flex.flex-wrap.gap-2
      = link_to "メモに戻る", edit_memo_path(@memo), class: "rounded-md border kb-border bg-white px-3 py-1.5 text-sm font-medium kb-text-primary kb-hover-row", target: "_blank", rel: "noopener"
      = link_to "メモを表示", memo_path(@memo), class: "rounded-md border kb-border bg-white px-3 py-1.5 text-sm font-medium kb-text-primary kb-hover-row", target: "_blank", rel: "noopener"

  .mt-4.rounded-md.border.kb-border.bg-[var(--kb-bg-muted)].px-3.py-2.text-sm.kb-text-secondary
    | 本文への挿入:
    code.ml-1= asciidoc
    | （保存後にメモへコミットすると Git に記録されます）

  = form_with url: memo_diagram_path(@memo, diagram_key), method: :patch, class: "mt-4 space-y-4" do |f|
    div.grid.gap-4.lg:grid-cols-2[
      data-controller="memo-diagram-editor"
      data-memo-diagram-editor-engine-value=@engine.to_s
      data-memo-diagram-editor-preview-url-value=preview_memo_diagram_path(@memo, diagram_key)
    ]
      .memo-diagram-editor.rounded-md.border.kb-border.bg-white
        label#diagram-source-label.block.border-b.kb-border.bg-[var(--kb-bg-muted)].px-3.py-2.text-sm.font-medium.kb-text-secondary for="source" ソース
        textarea#source.sr-only name="source" required=true tabindex="-1" autocomplete="off" data-memo-diagram-editor-target="field"
          = @source
        div.memo-diagram-editor__host.relative[data-memo-diagram-editor-target="host"]

      .memo-diagram-editor-preview.rounded-md.border.kb-border.bg-white
        .border-b.kb-border.bg-[var(--kb-bg-muted)].px-3.py-2.text-sm.font-medium.kb-text-secondary プレビュー
        p.hidden.px-3.py-2.text-xs.kb-text-muted data-memo-diagram-editor-target="previewLoading"
          | 生成中…
        p.hidden.px-3.py-2.text-sm.text-red-600 data-memo-diagram-editor-target="previewError"
        .memo-diagram-editor-preview__canvas.flex.min-h-96.items-start.justify-center.p-4 data-memo-diagram-editor-target="preview"

    p.text-xs.kb-text-muted
      | 保存すると Kroki で SVG を生成し、
      code= @source_relative.sub(/\.[^.]+$/, ".svg")
      | に書き込みます。編集中のプレビューは保存前の内容を Kroki で描画したものです。メモ表示では
      code= asciidoc
      | としてプレビューされます。

    .flex.gap-2
      = f.submit "保存して SVG を更新", class: "kb-chrome-btn-primary px-4 py-2 text-sm"
      = link_to "キャンセル", edit_memo_path(@memo), class: "rounded-md border kb-border bg-white px-4 py-2 text-sm font-medium kb-text-primary kb-hover-row"

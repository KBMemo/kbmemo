- content_for :title, "タグを統合"

- content_for :memos_editor do
  .max-w-md
    h1.mb-4 class=kb_page_title タグを統合
    p.mb-6.text-sm.leading-relaxed.kb-text-secondary
      | 統合元のタグは削除され、付いていたメモはすべて統合先のタグへ付け替えられます。すでに統合先のタグを持つメモでは、統合元の紐付けだけが外れます。
    - if @tags_for_select.size >= 2
      = form_with url: merge_tags_path, method: :post, class: "space-y-5" do
        div
          = label_tag :source_tag_id, "統合元（削除されるタグ）", class: "#{kb_label} mb-1"
          = select_tag :source_tag_id, options_from_collection_for_select(@tags_for_select, :id, :name, @source_tag&.id), class: kb_field_input_classes
        div
          = label_tag :target_tag_id, "統合先（残るタグ）", class: "#{kb_label} mb-1"
          = select_tag :target_tag_id, options_from_collection_for_select(@tags_for_select, :id, :name, nil), class: kb_field_input_classes
        .flex.flex-wrap.gap-3.pt-2
          = submit_tag "統合する", class: "kb-chrome-btn-primary px-4 py-2", data: { turbo_confirm: "統合元のタグを削除し、メモの紐付けを移します。よろしいですか？", theme_slot: "btn-primary" }
          = link_to "一覧へ", tags_path, class: "kb-chrome-btn-secondary px-4 py-2"
    - elsif @tags_for_select.any?
      p.text-sm.kb-text-muted タグが1件しかないため、統合できる相手がありません。
      p.mt-4
        = link_to "一覧へ", tags_path, class: "kb-chrome-link text-sm font-medium underline"
    - else
      p.text-sm.kb-text-muted タグがありません。
      p.mt-4
        = link_to "一覧へ", tags_path, class: "kb-chrome-link text-sm font-medium underline"

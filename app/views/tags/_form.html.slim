= form_with model: @tag, class: "space-y-5" do |f|
  - if @tag.errors.any?
    .kb-alert.kb-alert-danger
      ul.list-inside.list-disc
        - @tag.errors.full_messages.each do |msg|
          li = msg

  div
    = f.label :name, "タグ名", class: "#{kb_label} mb-1"
    = f.text_field :name, autocomplete: "off", class: memo_form_underline_input, aria: kb_field_error_aria(@tag, :name, describedby: "tag-name-help")
    - if kb_field_error?(@tag, :name)
      p.mt-1.text-sm.kb-status-danger id=kb_field_error_id(@tag, :name) = kb_field_error_message(@tag, :name)
    p#tag-name-help.mt-1.text-xs.kb-text-muted 表示名が変わります。同一の表記（大文字小文字・前後空白の違いなど）は内部キーでまとまります。

  .flex.gap-3.pt-2
    = f.submit "更新", class: "kb-chrome-btn-primary kb-btn-md", data: { theme_slot: "btn-primary" }
    = link_to "一覧へ", tags_path, class: "kb-chrome-btn-secondary kb-btn-md"

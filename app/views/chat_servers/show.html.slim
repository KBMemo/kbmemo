- content_for :title, "Chat サーバー設定"

.chat-server-page.mx-auto.w-full.max-w-3xl
  header.mb-6
    h1 class=kb_page_title Chat サーバー設定
    p.mt-2.text-sm.kb-text-secondary
      | ローカル llama-server の接続先 URL です。役割ごとに別ホスト・別 PC へ分散しても構いません。
    p.mt-1.text-xs.kb-text-muted
      | 空欄にすると環境既定（#{Chat::ServerEndpoints.default_host} + 既定ポート）を使います。

  - if flash[:notice].present?
    p.mt-4.text-sm.kb-status-success = flash[:notice]

  .chat-server-panel data-controller="chat-server" data-chat-server-health-url-value=health_check_chat_server_path(format: :json)
    = form_with url: chat_server_path, method: :patch, class: "mt-6 space-y-8" do |f|
      section
        h2 class=kb_section_title 役割ごとの接続先
        .mt-4.overflow-x-auto
          table class="w-full text-sm border-collapse"
            thead
              tr class="text-left kb-text-muted"
                th class="pr-3 pb-2 font-medium" 役割
                th class="pr-3 pb-2 font-medium" モデル
                th class="pr-3 pb-2 font-medium" 既定ポート
                th class="pb-2 font-medium" 接続 URL
            tbody
              - Chat::ServerEndpoints::ROLES.each do |role|
                - model_entry = @models_config[role]
                - model_name = model_entry.is_a?(Hash) ? (model_entry[:model] || model_entry["model"]) : nil
                - saved_url = @settings.dig("base_urls", role.to_s)
                - effective_url = @role_urls[role]
                - placeholder_url = @default_urls[role]
                tr class="border-t kb-border align-top"
                  td class="pr-3 py-3 whitespace-nowrap"
                    = @role_labels[role]
                  td class="pr-3 py-3 font-mono text-xs"
                    = model_name
                  td class="pr-3 py-3 font-mono text-xs"
                    = @default_ports[role]
                  td class="py-3"
                    = text_field_tag "chat_server_settings[base_urls][#{role}]", saved_url, class: "kb-input w-full min-w-48 font-mono text-xs", placeholder: placeholder_url, autocomplete: "off", aria: { label: "#{@role_labels[role]} の接続 URL（現在 #{effective_url}）" }

      .flex.flex-wrap.gap-3
        button.kb-chrome-btn-primary type="submit" data-theme-slot="btn-primary" 保存
        button.kb-chrome-btn-secondary type="button" data-action="chat-server#checkHealth" data-chat-server-target="healthButton" 接続確認
        = link_to "AI チャット", agent_chat_path, class: "kb-chrome-btn-secondary kb-btn-md"
        = link_to "プロフィール", edit_profile_path, class: "kb-chrome-btn-secondary kb-btn-md"

    .mt-6.hidden data-chat-server-target="healthPanel"
      h2 class=kb_section_title 接続確認結果
      ul.mt-3.space-y-2 data-chat-server-target="healthList"

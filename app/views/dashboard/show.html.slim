- content_for :title, "ホーム"

.kb-dashboard
  .mb-6.flex.flex-wrap.items-end.justify-between.gap-3
    div
      h1 class=kb_page_title ホーム
      p.mt-1.text-sm.kb-text-secondary = "#{rodauth.rails_account.display_name} さんの最近の活動"

  .kb-dashboard-layout
    .kb-dashboard-column
      section.kb-dashboard-section aria-labelledby="dashboard-calendar"
        .kb-dashboard-section-header
          h2#dashboard-calendar カレンダー
        = render "schedule_calendar", calendar: @schedule_calendar

      section.kb-dashboard-section aria-labelledby="dashboard-schedule"
        .kb-dashboard-section-header
          h2#dashboard-schedule 予定
        - if @overview.schedule.any?
          ul.kb-dashboard-list
            - @overview.schedule.each do |entry|
              li
                = link_to memo_path(entry.memo), class: "kb-dashboard-row" do
                  time.kb-dashboard-date datetime=entry.date.iso8601
                    span = l(entry.date, format: "%m/%d")
                    small = l(entry.date, format: "%a")
                  span.min-w-0.flex-1
                    span.block.truncate.font-medium.kb-text-primary = entry.memo.title
                    - if entry.memo.board
                      span.mt-1.block.text-xs.kb-text-muted = entry.memo.board.title
        - else
          p.kb-dashboard-empty 今後の予定はありません。

    .kb-dashboard-column
      section.kb-dashboard-section aria-labelledby="dashboard-boards"
        .kb-dashboard-section-header
          h2#dashboard-boards カンバン
          = link_to "すべて表示", boards_path, class: "kb-chrome-link text-xs"
        - if @overview.boards.any?
          ul.kb-dashboard-list
            - @overview.boards.each do |board|
              li
                = link_to board_path(board), class: "kb-dashboard-row" do
                  span.min-w-0
                    span.block.truncate.font-medium.kb-text-primary = board.title
                    span.mt-1.block.text-xs.kb-text-muted = "#{board[:memo_count]} 件のメモ"
                  time.shrink-0.text-xs.kb-text-muted datetime=board.updated_at.iso8601
                    = l(board.updated_at, format: :short)
        - else
          p.kb-dashboard-empty カンバンはまだありません。

      section.kb-dashboard-section aria-labelledby="dashboard-latest-memos"
        .kb-dashboard-section-header
          h2#dashboard-latest-memos 最新のメモ
          = render "shared/memo_create_actions",
            templates: @memo_templates,
            id_prefix: "dashboard",
            new_link_class: "kb-sidebar-link kb-focus-ring",
            class_name: "kb-dashboard-create-actions"
        - if @overview.latest_memos.any?
          ul.kb-dashboard-list
            - @overview.latest_memos.each do |memo|
              li
                = link_to edit_memo_path(memo), class: "kb-dashboard-row", data: { turbo: false } do
                  span.min-w-0
                    span.block.truncate.font-medium.kb-text-primary = memo.title
                    - if memo.tags.any?
                      span.mt-1.flex.flex-wrap.gap-1
                        - memo.tags.first(3).each do |tag|
                          span.kb-list-tag = tag.name
                  time.shrink-0.text-xs.kb-text-muted datetime=memo.updated_at.iso8601
                    = l(memo.updated_at, format: :short)
        - else
          p.kb-dashboard-empty メモはまだありません。

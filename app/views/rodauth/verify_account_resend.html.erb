<%= form_with url: rodauth.verify_account_resend_path, method: :post, data: { turbo: false }, class: "w-full max-w-sm" do |form| %>
  <div class="mb-4 text-sm">
    <%== rodauth.verify_account_resend_explanatory_text %>
  </div>

  <% if params[rodauth.login_param] %>
    <%= form.hidden_field rodauth.login_param, value: params[rodauth.login_param] %>
  <% else %>
    <div class="mb-6">
      <%= form.label "login", rodauth.login_label, class: kb_label %>
      <%= form.email_field rodauth.login_param, value: params[rodauth.login_param], id: "login", autocomplete: "email", required: true, class: kb_auth_field_classes(error: rodauth.field_error(rodauth.login_param)), aria: ({ invalid: true, describedby: "login_error_message" } if rodauth.field_error(rodauth.login_param)) %>
      <%= content_tag(:span, rodauth.field_error(rodauth.login_param), class: "block mt-1 text-xs kb-status-danger", id: "login_error_message") if rodauth.field_error(rodauth.login_param) %>
    </div>
  <% end %>

  <%= form.submit rodauth.verify_account_resend_button, class: kb_auth_submit_classes %>
<% end %>

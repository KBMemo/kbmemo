<%= form_with url: rodauth.change_password_path, method: :post, data: { turbo: false }, class: "w-full max-w-sm" do |form| %>
  <% if rodauth.change_password_requires_password? %>
    <div class="mb-6">
      <%= form.label "password", rodauth.password_label, class: "block text-sm font-semibold text-zinc-800" %>
      <%= form.password_field rodauth.password_param, value: "", id: "password", autocomplete: rodauth.password_field_autocomplete_value, required: true, class: "mt-2 text-sm w-full px-3 py-2 border rounded-md bg-white text-zinc-900 #{rodauth.field_error(rodauth.password_param) ? "border-red-600 focus:border-red-600 focus:ring-1 focus:ring-red-500" : "border-zinc-300 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500" }", aria: ({ invalid: true, describedby: "password_error_message" } if rodauth.field_error(rodauth.password_param)) %>
      <%= content_tag(:span, rodauth.field_error(rodauth.password_param), class: "block mt-1 text-red-600 text-xs", id: "password_error_message") if rodauth.field_error(rodauth.password_param) %>
    </div>
  <% end %>

  <div class="mb-6">
    <%= form.label "new-password", rodauth.new_password_label, class: "block text-sm font-semibold text-zinc-800" %>
    <%= form.password_field rodauth.new_password_param, value: "", id: "new-password", autocomplete: "new-password", required: true, class: "mt-2 text-sm w-full px-3 py-2 border rounded-md bg-white text-zinc-900 #{rodauth.field_error(rodauth.new_password_param) ? "border-red-600 focus:border-red-600 focus:ring-1 focus:ring-red-500" : "border-zinc-300 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500" }", aria: ({ invalid: true, describedby: "new-password_error_message" } if rodauth.field_error(rodauth.new_password_param)) %>
    <%= content_tag(:span, rodauth.field_error(rodauth.new_password_param), class: "block mt-1 text-red-600 text-xs", id: "new-password_error_message") if rodauth.field_error(rodauth.new_password_param) %>
  </div>

  <% if rodauth.require_password_confirmation? %>
    <div class="mb-6">
      <%= form.label "password-confirm", rodauth.password_confirm_label, class: "block text-sm font-semibold text-zinc-800" %>
      <%= form.password_field rodauth.password_confirm_param, value: "", id: "password-confirm", autocomplete: "new-password", required: true, class: "mt-2 text-sm w-full px-3 py-2 border rounded-md bg-white text-zinc-900 #{rodauth.field_error(rodauth.password_confirm_param) ? "border-red-600 focus:border-red-600 focus:ring-1 focus:ring-red-500" : "border-zinc-300 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500" }", aria: ({ invalid: true, describedby: "password-confirm_error_message" } if rodauth.field_error(rodauth.password_confirm_param)) %>
      <%= content_tag(:span, rodauth.field_error(rodauth.password_confirm_param), class: "block mt-1 text-red-600 text-xs", id: "password-confirm_error_message") if rodauth.field_error(rodauth.password_confirm_param) %>
    </div>
  <% end %>

  <%= form.submit rodauth.change_password_button, class: "w-full cursor-pointer rounded-md bg-zinc-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2" %>
<% end %>

<%= form_with url: rodauth.close_account_path, method: :post, data: { turbo: false }, class: "w-full max-w-sm" do |form| %>
  <% if rodauth.close_account_requires_password? %>
    <div class="mb-6">
      <%= form.label "password", rodauth.password_label, class: kb_label %>
      <%= form.password_field rodauth.password_param, value: "", id: "password", autocomplete: rodauth.password_field_autocomplete_value, required: true, class: kb_auth_field_classes(error: rodauth.field_error(rodauth.password_param)), aria: ({ invalid: true, describedby: "password_error_message" } if rodauth.field_error(rodauth.password_param)) %>
      <%= content_tag(:span, rodauth.field_error(rodauth.password_param), class: "block mt-1 text-xs kb-status-danger", id: "password_error_message") if rodauth.field_error(rodauth.password_param) %>
    </div>
  <% end %>

  <%= form.submit rodauth.close_account_button, class: "kb-danger-btn kb-auth-submit kb-focus-ring" %>
<% end %>

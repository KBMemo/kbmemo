<%= form_with url: rodauth.remember_path, method: :post, data: { turbo: false }, class: "w-full max-w-sm" do |form| %>
  <fieldset class="mb-6 space-y-2">
    <div class="flex items-center space-x-2">
      <%= form.radio_button rodauth.remember_param, rodauth.remember_remember_param_value, id: "remember-remember", class: "kb-border kb-text-primary kb-control-accent" %>
      <%= form.label "remember-remember", rodauth.remember_remember_label, class: "text-sm kb-text-primary" %>
    </div>
    <div class="flex items-center space-x-2">
      <%= form.radio_button rodauth.remember_param, rodauth.remember_forget_param_value, id: "remember-forget", class: "kb-border kb-text-primary kb-control-accent" %>
      <%= form.label "remember-forget", rodauth.remember_forget_label, class: "text-sm kb-text-primary" %>
    </div>
    <div class="flex items-center space-x-2">
      <%= form.radio_button rodauth.remember_param, rodauth.remember_disable_param_value, id: "remember-disable", class: "kb-border kb-text-primary kb-control-accent" %>
      <%= form.label "remember-disable", rodauth.remember_disable_label, class: "text-sm kb-text-primary" %>
    </div>
  </fieldset>

  <%= form.submit rodauth.remember_button, class: kb_auth_submit_classes %>
<% end %>

<%= form_with url: rodauth.reset_password_request_path, method: :post, data: { turbo: false }, class: "w-full max-w-sm" do |form| %>
  <div class="mb-4 text-sm">
    <%== rodauth.reset_password_explanatory_text %>
  </div>

  <% if params[rodauth.login_param] && !rodauth.field_error(rodauth.login_param) %>
    <%= form.hidden_field rodauth.login_param, value: params[rodauth.login_param] %>
  <% else %>
    <div class="mb-6">
      <%= form.label "login", rodauth.login_label, class: "block text-sm font-semibold text-zinc-800" %>
      <%= form.email_field rodauth.login_param, value: params[rodauth.login_param], id: "login", autocomplete: "email", required: true, class: "mt-2 text-sm w-full px-3 py-2 border rounded-md bg-white text-zinc-900 #{rodauth.field_error(rodauth.login_param) ? "border-red-600 focus:border-red-600 focus:ring-1 focus:ring-red-500" : "border-zinc-300 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500" }", aria: ({ invalid: true, describedby: "login_error_message" } if rodauth.field_error(rodauth.login_param)) %>
      <%= content_tag(:span, rodauth.field_error(rodauth.login_param), class: "block mt-1 text-red-600 text-xs", id: "login_error_message") if rodauth.field_error(rodauth.login_param) %>
    </div>
  <% end %>

  <%= form.submit rodauth.reset_password_request_button, class: "w-full cursor-pointer rounded-md bg-zinc-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2" %>
<% end %>

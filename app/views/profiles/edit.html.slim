- content_for :title, "プロフィール"

h1 class=kb_page_title プロフィール

section.mt-8
  h2 class=kb_section_title ニックネーム（表示名）
  p.mt-1.text-sm.kb-text-secondary
    | ヘッダーやメモディレクトリの表示に使います。空にするとメールアドレスが表示されます。

section.mt-10
  h2 class=kb_section_title OpenAI API キー（BYOK）
  p.mt-1.text-sm.kb-text-secondary
    | ローカル AI に接続できない場合のフォールバック用です。キーは暗号化して保存し、OpenAI API 呼び出し時のみサーバーから送信します。
  p.mt-1.text-xs.kb-text-muted
    | 本文は OpenAI に送信されます。機密メモでは利用を控えてください。

= form_with model: @account, url: profile_path, method: :patch, class: "mt-6 space-y-8" do |f|
  - if @account.errors.any?
    ul.mb-4.list-inside.list-disc.text-sm.kb-status-danger
      - @account.errors.full_messages.each do |msg|
        li = msg

  div
    = f.label :nickname, "ニックネーム", class: kb_label
    = f.text_field :nickname, class: "#{kb_field_input_classes} max-w-md", autocomplete: "nickname", maxlength: 40, placeholder: "例: けんせい", aria: kb_field_error_aria(@account, :nickname, describedby: "account-nickname-help")
    - if kb_field_error?(@account, :nickname)
      p.mt-1.text-sm.kb-status-danger id=kb_field_error_id(@account, :nickname) = kb_field_error_message(@account, :nickname)
    p#account-nickname-help.mt-1.text-xs.kb-text-muted 最大40文字

  div
    = f.label :openai_api_key, "OpenAI API キー", class: kb_label
    - if @account.openai_api_key_configured? && @account.openai_api_key_decryptable?
      p.mt-1.text-xs.kb-status-success 設定済み（再入力すると上書きします）
    - elsif @account.openai_api_key_configured?
      p.mt-1.text-xs.kb-status-warning 保存済みのキーを復号できません。開発用の暗号化鍵が本番と異なるためです。再入力するか、下のチェックで削除してください。
    - else
      p.mt-1.text-xs.kb-text-muted 未設定 — ローカル AI のみ使用します
    = f.password_field :openai_api_key, class: "#{kb_field_input_classes} max-w-md font-mono", autocomplete: "off", placeholder: "sk-…", aria: kb_field_error_aria(@account, :openai_api_key, describedby: "account-openai-api-key-help")
    - if kb_field_error?(@account, :openai_api_key)
      p.mt-1.text-sm.kb-status-danger id=kb_field_error_id(@account, :openai_api_key) = kb_field_error_message(@account, :openai_api_key)
    .mt-2.flex.items-center.gap-2
      = f.check_box :clear_openai_api_key, class: "rounded kb-border"
      = f.label :clear_openai_api_key, "保存済みのキーを削除する", class: "text-sm kb-text-secondary"
    p#account-openai-api-key-help.mt-1.text-xs.kb-text-muted
      | API キーは
      = link_to "platform.openai.com", "https://platform.openai.com/api-keys", class: "kb-chrome-link underline", target: "_blank", rel: "noopener"
      |  で発行できます（ChatGPT Plus とは別課金）。

  .flex.flex-wrap.gap-3
    = f.submit "保存", class: "kb-chrome-btn-primary kb-btn-md", data: { theme_slot: "btn-primary" }
    = link_to "メモ一覧へ", memos_path, class: "kb-chrome-btn-secondary kb-btn-md"

section.mt-10
  h2 class=kb_section_title Google Calendar
  p.mt-1.text-sm.kb-text-secondary
    | 予定をメモとして取り込み、カンバンの予定日（scheduled_on）に反映します。読み取り専用で同期されます。
  - if GoogleCalendar::Credentials.valid?
    - if @account.google_calendar_refresh_token_undecryptable?
      p.mt-2.text-xs.kb-status-warning 保存済みの連携トークンを復号できません。開発用の暗号化鍵が本番と異なるためです。再連携してください。
    - if @account.google_calendar_connected?
      p.mt-2.text-xs.kb-status-success Google Calendar 連携済み
      - if @account.google_calendar_meta["last_synced_at"].present?
        p.mt-1.text-xs.kb-text-muted
          | 最終同期:
          = @account.google_calendar_meta["last_synced_at"]
      - if @google_calendar_synced_memos_count.positive?
        p.mt-1.text-xs.kb-text-muted
          | 取り込み済みメモ:
          = @google_calendar_synced_memos_count
          | 件
      .mt-4.flex.flex-wrap.gap-3
        = button_to "今すぐ同期", google_calendar_sync_path, method: :post, class: "kb-chrome-btn-primary kb-btn-md", data: { theme_slot: "btn-primary" }
        = button_to "取り込みデータをクリア", google_calendar_clear_data_path, method: :delete, class: "kb-chrome-btn-secondary kb-btn-md", form: { data: { turbo_confirm: "Google Calendar から取り込んだメモをすべて削除します。連携は維持され、次回同期で再取り込みできます。続行しますか？" } }
        = button_to "連携を解除", google_calendar_disconnect_path, method: :delete, class: "kb-chrome-btn-secondary kb-btn-md", form: { data: { turbo_confirm: "Google Calendar 連携を解除しますか？" } }
      p.mt-3.text-xs.kb-text-muted
        | CLI:
        code.kb-code-inline bin/rails kbmemo:google_calendar:clear ACCOUNT_ID=#{@account.id}
    - else
      p.mt-2.text-xs.kb-status-warning 未連携
      .mt-4
        = link_to "Google Calendar と連携", google_calendar_connect_path, class: "kb-chrome-btn-primary kb-btn-md inline-block", data: { theme_slot: "btn-primary" }
  - else
    p.mt-2.text-xs.kb-status-warning
      - if (reason = GoogleCalendar::Credentials.misconfiguration_reason)
        = reason
      - else
        | OAuth 未設定
    p.mt-2.text-xs.kb-text-muted
      | 1. Google Cloud Console で「OAuth 2.0 クライアント ID」を
      strong Web アプリケーション
      |  として作成
      br
      | 2. 承認済みリダイレクト URI に次を
      strong 完全一致
      |  で登録:
    code.mt-2.block.overflow-x-auto.rounded.kb-chrome-panel.px-3.py-2.text-xs = @google_calendar_callback_url
    p.mt-2.text-xs.kb-text-muted
      | 3.
      code.kb-code-inline bin/rails credentials:edit
      |  で
      code.kb-code-inline google_calendar.client_id
      |  /
      code.kb-code-inline client_secret
      |  を設定（
      code.kb-code-inline config/credentials/google_calendar.example.yml
      |  参照）。設定後はアプリを再起動。

section.mt-10#account-api-token data-controller=(@revealed_api_token.present? ? "scroll-into-view" : nil) tabindex=(@revealed_api_token.present? ? "-1" : nil)
  h2 class=kb_section_title アカウント API トークン
  p.mt-1.text-sm.kb-text-secondary
    | API からメモの取得・作成・更新・削除を行う際に使います。Bearer トークンとして
    code.kb-code-inline Authorization
    |  ヘッダーに付けてください。ブックマークレットには使用しないでください。
  - if @account.api_token_configured?
    p.mt-2.text-xs.kb-status-success
      | 設定済み（先頭:
      code.kb-code-inline = @account.api_token_prefix
      | ）
    - if @account.api_token_created_at
      p.mt-1.text-xs.kb-text-muted
        | 発行日時:
        = l(@account.api_token_created_at, format: :long)
  - else
    p.mt-2.text-xs.kb-status-warning 未設定 — アカウント API は利用できません

  - if @revealed_api_token.present?
    .mt-4.kb-alert.kb-alert-warning role="status"
      p.text-sm.font-medium 発行したトークン（再表示できません）
      code.mt-2.block.overflow-x-auto.rounded.kb-chrome-panel.px-3.py-2.text-xs.kb-text-primary = @revealed_api_token

  .mt-4.flex.flex-wrap.gap-3
    = button_to "トークンを発行", api_token_profile_path, method: :post, class: "kb-chrome-btn-primary kb-btn-md", data: { theme_slot: "btn-primary" }, form: { data: { turbo: false, turbo_confirm: "既存のトークンは無効になります。続行しますか？" } }
    - if @account.api_token_configured?
      = button_to "トークンを無効化", api_token_profile_path, method: :delete, class: "kb-chrome-btn-secondary kb-btn-md", form: { data: { turbo_confirm: "アカウント API が利用できなくなります。続行しますか？" } }

section.mt-10#web-clip-token data-controller=(@revealed_web_clip_token.present? ? "scroll-into-view" : nil) tabindex=(@revealed_web_clip_token.present? ? "-1" : nil)
  h2 class=kb_section_title Web クリップトークン
  p.mt-1.text-sm.kb-text-secondary
    | ブックマークレットから選択範囲を保存するための専用トークンです。
    code.kb-code-inline POST /api/clips
    |  以外の API には使用できません。
  - if @web_clip_tokens.any?
    p.mt-2.text-xs.kb-status-success = "#{@web_clip_tokens.size} 件のトークンが有効です"
  - else
    p.mt-2.text-xs.kb-status-warning 未設定 — ブックマークレットから保存できません

  - if @revealed_web_clip_token.present?
    .mt-4.kb-alert.kb-alert-warning role="status"
      p.text-sm.font-medium 発行したトークン（再表示できません）
      code.mt-2.block.overflow-x-auto.rounded.kb-chrome-panel.px-3.py-2.text-xs.kb-text-primary = @revealed_web_clip_token

  = form_with url: web_clip_tokens_profile_path, method: :post, class: "mt-4 flex flex-wrap items-end gap-3", data: { turbo: false } do |form|
    .min-w-64
      = form.label :web_clip_token_name, "端末名（任意）", class: kb_label
      = form.text_field :web_clip_token_name, maxlength: 80, placeholder: "例: 自宅 Chrome", class: kb_field_input_classes
    = form.submit "新しいトークンを発行", class: "kb-chrome-btn-primary kb-btn-md", data: { theme_slot: "btn-primary" }

  - if @web_clip_tokens.any?
    ul.mt-4.divide-y.kb-border-subtle
      - @web_clip_tokens.each do |token|
        li.flex.flex-wrap.items-center.justify-between.gap-3.py-3
          div
            p.text-sm.font-medium.kb-text-primary = token.name.presence || "名称なし"
            p.mt-1.text-xs.kb-text-muted
              code.kb-code-inline = token.token_prefix
              |  ・
              = l(token.created_at, format: :long)
          = button_to "無効化", web_clip_token_profile_path(token_id: token.id), method: :delete, class: "kb-chrome-btn-secondary kb-btn-sm", form: { data: { turbo_confirm: "この端末のWeb クリップトークンを無効化しますか？" } }

  = render "profiles/clip_bookmarklet_setup", base_url: request.base_url, revealed_token: @revealed_web_clip_token, token_configured: @web_clip_tokens.any?, web_clip_tokens: @web_clip_tokens

section.mt-10#tsuzura-cli-token data-controller=(@revealed_tsuzura_api_token.present? ? "scroll-into-view" : nil) tabindex=(@revealed_tsuzura_api_token.present? ? "-1" : nil)
  h2 class=kb_section_title Tsuzura CLI トークン
  p.mt-1.text-sm.kb-text-secondary
    | Tsuzura へ写真を一括登録する CLI (
    code.kb-code-inline tsuzura import
    | ) 用です。環境変数
    code.kb-code-inline TSUZURA_API_TOKEN
    | に設定してください。
  - if @account.tsuzura_api_token_configured?
    p.mt-2.text-xs.kb-status-success
      | 設定済み（先頭:
      code.kb-code-inline = @account.tsuzura_api_token_prefix
      | ）
    - if @account.tsuzura_api_token_created_at
      p.mt-1.text-xs.kb-text-muted
        | 発行日時:
        = l(@account.tsuzura_api_token_created_at, format: :long)
  - else
    p.mt-2.text-xs.kb-status-warning 未設定 — CLI からの登録は利用できません

  - if @revealed_tsuzura_api_token.present?
    .mt-4.kb-alert.kb-alert-warning role="status"
      p.text-sm.font-medium 発行したトークン（再表示できません）
      code.mt-2.block.overflow-x-auto.rounded.kb-chrome-panel.px-3.py-2.text-xs.kb-text-primary = @revealed_tsuzura_api_token

  .mt-4.flex.flex-wrap.gap-3
    = button_to "トークンを発行", tsuzura_api_token_profile_path, method: :post, class: "kb-chrome-btn-primary kb-btn-md", data: { theme_slot: "btn-primary" }, form: { data: { turbo: false, turbo_confirm: "既存のトークンは無効になります。続行しますか？" } }
    - if @account.tsuzura_api_token_configured?
      = button_to "トークンを無効化", tsuzura_api_token_profile_path, method: :delete, class: "kb-chrome-btn-secondary kb-btn-md", form: { data: { turbo_confirm: "CLI からの登録ができなくなります。続行しますか？" } }

ruby:
  secret_flash_keys = %i[clip_api_token tsuzura_api_token]
#flash-live class="pointer-events-none fixed top-4 right-4 z-50 flex w-[min(100%-2rem,24rem)] flex-col gap-2" data-flash-notice-target="live" aria-live="polite"
  - flash.each do |level, message|
    - next if message.blank?
    - next if secret_flash_keys.include?(level.to_sym)
    - alert_classes = (level.to_sym == :notice) ? "border-emerald-200 bg-emerald-50 text-emerald-900" : "border-amber-200 bg-amber-50 text-amber-900"
    - dismiss_ring = (level.to_sym == :notice) ? "focus-visible:ring-emerald-400" : "focus-visible:ring-amber-400"
    div class="pointer-events-auto flex items-start gap-2 rounded-md border px-3 py-2 text-sm shadow-md transition-all duration-200 ease-out #{alert_classes}" role="status" data-flash-notice-target="message"
      span.min-w-0.flex-1 = message
      button.shrink-0.rounded.p-0.5.text-base.leading-none.opacity-60.hover:opacity-100.focus:outline-none.focus-visible:ring-2.focus-visible:ring-offset-1 type="button" class=dismiss_ring data-action="flash-notice#dismiss" aria-label="メッセージを閉じる"
        | ×

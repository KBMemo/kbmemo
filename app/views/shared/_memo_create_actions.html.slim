.kb-sidebar-create-row class=local_assigns[:class_name]
  = link_to new_memo_path, class: new_link_class, data: { turbo: false } do
    span +新規
  - if templates.any?
    .relative data-controller="user-menu"
      button.kb-sidebar-template-trigger.inline-flex.items-center.gap-1 id="#{id_prefix}-template-create-trigger" type="button" data-user-menu-target="button" data-action="click->user-menu#toggle" aria-expanded="false" aria-haspopup="true"
        span Templateから作成
        svg.h-4.w-4.flex-shrink-0.kb-text-muted xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"
          path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"
      .kb-menu-panel.kb-sidebar-template-menu.absolute.right-0.top-full.z-50.mt-1.hidden.overflow-y-auto.rounded-md.py-1.text-sm id="#{id_prefix}-template-create-menu" data-user-menu-target="panel" role="menu"
        - templates.each do |template|
          = link_to template.name, new_memo_path(template_id: template.id), class: "kb-menu-item block truncate px-3 py-2", role: "menuitem", title: template.name, data: { turbo: false }
  - else
    button.kb-sidebar-template-trigger type="button" disabled=true title="利用できるテンプレートがありません"
      | Templateから作成

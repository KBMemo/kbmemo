ruby:
  directory_options = Array(directory_options)
  by_parent = memo_directory_nav_children_index(directory_options)
  picker_roots = memo_directory_nav_tree_roots(directory_options, by_parent)
  unselected = selected_directory.nil? || selected_directory.root?
  initial_path = unselected && placeholder_text.present? ? placeholder_text : memo_directory_path_from_root_label(selected_directory)
  field_value = unselected ? "" : selected_directory.id
  hidden_data = { memo_directory_parent_picker_target: "hiddenInput" }.merge(hidden_field_data || {})
  sidebar_open_memo = local_assigns[:sidebar_open_memo]
  sidebar_open_path = local_assigns[:sidebar_open_path].presence || (sidebar_open_memo ? edit_memo_path(sidebar_open_memo) : nil)
  picker_controllers = sidebar_open_path ? "memo-directory-parent-picker memo-directory-sidebar-open" : "memo-directory-parent-picker"

.relative.min-w-0.flex-1 data-controller=picker_controllers data-memo-directory-sidebar-open-memo-path-value=sidebar_open_path
  .flex.min-w-0.flex-wrap.items-baseline.gap-x-1.gap-y-1.text-sm
    span.shrink-0.font-medium.kb-text-primary = "#{label_text}："
    span.min-w-0.truncate.kb-text-secondary data-memo-directory-parent-picker-target="pathLabel" = initial_path
    button type="button" class=kb_icon_btn("shrink-0 rounded px-1 py-0.5") data-memo-directory-parent-picker-target="toggleButton" data-action="memo-directory-parent-picker#toggle" aria-expanded="false" aria-haspopup="listbox" aria-label="#{label_text}を選択" ▼
    - if sidebar_open_path
      button type="button" class="#{kb_icon_btn('shrink-0 ml-auto inline-flex items-center gap-1 rounded px-1.5 py-0.5')} disabled:cursor-not-allowed disabled:opacity-40" title="サイドバーでこのディレクトリを表示" data-memo-directory-sidebar-open-target="button" data-action="click->memo-directory-sidebar-open#open" aria-label="サイドバーでこのディレクトリを表示"
        i.h-4.w-4 aria-hidden="true" data-lucide="panel-left-open"
  - if local_assigns[:form_builder]
    = form_builder.hidden_field field_method, value: field_value, data: hidden_data
  - else
    = hidden_field_tag field_name, field_value, id: field_id, data: hidden_data
  div class="kb-menu-panel absolute left-0 top-full z-30 mt-1 hidden max-h-72 w-full min-w-[16rem] max-w-md overflow-y-auto rounded-md py-2" data-memo-directory-parent-picker-target="panel" role="listbox"
    ul.px-2
      - picker_roots.each do |dir|
        = render "shared/directory_tree_picker_branch", dir: dir, by_parent: by_parent, selected_directory: (unselected ? nil : selected_directory)

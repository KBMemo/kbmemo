ruby:
  directory_options = Array(directory_options)
  picker_field_id = local_assigns[:field_id]
  picker_field_name = local_assigns[:field_name]
  picker_field_method = local_assigns[:field_method]
  by_parent = memo_directory_nav_children_index(directory_options)
  picker_roots = memo_directory_nav_tree_roots(directory_options, by_parent)
  unselected = selected_directory.nil? || selected_directory.root?
  initial_path = unselected && placeholder_text.present? ? placeholder_text : memo_directory_path_from_root_label(selected_directory)
  field_value = unselected ? "" : selected_directory.id
  hidden_data = { memo_directory_parent_picker_target: "hiddenInput" }.merge(hidden_field_data || {})
  hidden_aria = local_assigns[:hidden_field_aria]
  sidebar_open_memo = local_assigns[:sidebar_open_memo]
  sidebar_open_path = local_assigns[:sidebar_open_path].presence || (sidebar_open_memo ? edit_memo_path(sidebar_open_memo) : nil)
  picker_controllers = sidebar_open_path ? "memo-directory-parent-picker memo-directory-sidebar-open" : "memo-directory-parent-picker"
  picker_dom_id = "#{picker_field_id.presence || picker_field_method || picker_field_name}_directory_picker".parameterize(separator: "_")
  picker_panel_id = "#{picker_dom_id}_panel"
  path_label_class = "min-w-0 flex-1 truncate text-left"

.kb-directory-picker.relative.min-w-0.max-w-full data-controller=picker_controllers data-memo-directory-sidebar-open-memo-path-value=sidebar_open_path
  .flex.min-w-0.items-center.gap-1.text-sm
    span.shrink-0.font-medium.kb-text-primary = "#{label_text}："
    - if sidebar_open_path
      button type="button" class="#{path_label_class} kb-directory-picker-path-button disabled:cursor-default disabled:opacity-100" data-memo-directory-parent-picker-target="pathLabel" data-memo-directory-sidebar-open-target="button" data-action="click->memo-directory-sidebar-open#open" title="サイドバーでこのディレクトリを表示" disabled=unselected = initial_path
    - else
      span class="#{path_label_class} kb-text-secondary" data-memo-directory-parent-picker-target="pathLabel" = initial_path
    button type="button" class=kb_icon_btn("shrink-0 rounded px-1 py-0.5") data-memo-directory-parent-picker-target="toggleButton" data-action="click->memo-directory-parent-picker#toggle keydown->memo-directory-parent-picker#toggleKeydown" aria-expanded="false" aria-haspopup="listbox" aria-controls=picker_panel_id aria-label="#{label_text}を選択" ▼
  - if local_assigns[:form_builder]
    = form_builder.hidden_field picker_field_method, value: field_value, data: hidden_data, aria: hidden_aria
  - else
    = hidden_field_tag picker_field_name, field_value, id: picker_field_id, data: hidden_data, aria: hidden_aria
  div id=picker_panel_id class="kb-menu-panel kb-picker-panel absolute left-0 top-full z-30 mt-1 hidden w-full max-w-md overflow-y-auto rounded-md py-2" data-memo-directory-parent-picker-target="panel" data-action="keydown->memo-directory-parent-picker#panelKeydown" role="listbox"
    ul.list-none.px-2.pl-0
      - picker_roots.each do |dir|
        = render "shared/directory_tree_picker_branch", dir: dir, by_parent: by_parent, selected_directory: (unselected ? nil : selected_directory), picker_dom_id: picker_dom_id

.flex.flex-col
  .flex-shrink-0.border-b.kb-border.px-3.py-3
    .min-w-0
      h2.text-sm.font-semibold.truncate.kb-text-primary = @notebook.title
      p.mt-0.5.text-xs.kb-text-muted
        = notebook_kind_label(@notebook)
        span.kb-text-subtle aria-hidden="true" ·
        = notebook_status_label(@notebook)
    .mt-2.flex.flex-wrap.items-center.gap-x-2.gap-y-1.text-xs
      - if help_show?
        = link_to "ヘルプトップ", help_path, class: "kb-chrome-link"
      - else
        = link_to "一覧", notebooks_path, class: "kb-chrome-link"
        - if @can_manage
          = link_to "編集", edit_notebook_path(@notebook), class: "kb-chrome-link"
          - if @notebook.notes?
            span.kb-text-muted 公開不可
          - elsif @notebook.published?
            = button_to "公開停止", unpublish_notebook_path(@notebook), method: :patch, class: "kb-chrome-link"
          - else
            = button_to "公開", publish_notebook_path(@notebook), method: :patch, class: "kb-chrome-link"
    - if @can_manage && @available_memos&.any?
      = form_with url: notebook_notebook_memos_path(@notebook), method: :post, class: "mt-3 flex min-w-0 flex-col gap-2" do
        = select_tag :memo_id, options_from_collection_for_select(@available_memos, :id, :title), include_blank: "メモを追加…", class: "#{kb_field_input_classes} w-full text-sm"
        = submit_tag "追加", class: "kb-chrome-btn-primary px-3 py-1.5 text-xs w-full", data: { theme_slot: "btn-primary" }
  .px-2.py-2
    = render "notebooks/memo_tree", notebook: @notebook

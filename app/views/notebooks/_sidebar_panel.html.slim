.flex.h-full.min-h-0.flex-col data-controller="notebook-memo-picker-dialog" data-notebook-memo-picker-dialog-search-url-value=available_memos_notebook_path(@notebook)
  .shrink-0.border-b.kb-border.px-3.py-3
    .flex.min-w-0.items-center.gap-2
      h2.text-sm.font-semibold.truncate.kb-text-primary = @notebook.title
      - if !help_show? && @can_manage
        = link_to edit_notebook_path(@notebook), class: "kb-toolbar-btn ml-auto shrink-0", aria: { label: "ノートブックを編集" }, title: "ノートブックを編集" do
          i aria-hidden="true" data-lucide="pencil"
    .min-w-0
      p.mt-0.5.text-xs.kb-text-muted
        = notebook_kind_label(@notebook)
        span.kb-text-subtle aria-hidden="true" ·
        = notebook_status_label(@notebook)
    - if help_show? || @can_manage
      .mt-2.flex.flex-wrap.items-center.gap-x-2.gap-y-1.text-xs
        - if help_show?
          = link_to "ヘルプトップ", help_path, class: "kb-chrome-link"
        - elsif @can_manage
          = button_to create_blank_notebook_notebook_memos_path(@notebook), method: :post, form_class: "contents", class: "kb-chrome-link inline-flex items-center gap-1 border-0 bg-transparent p-0", title: "新規メモを作成して末尾に追加" do
            i class="h-3.5 w-3.5" aria-hidden="true" data-lucide="plus"
            span 新規メモ
          - if @notebook.notes?
            span.kb-text-muted 公開不可
          - elsif @notebook.published?
            = button_to "公開停止", unpublish_notebook_path(@notebook), method: :patch, class: "kb-chrome-link"
          - else
            = button_to "公開", publish_notebook_path(@notebook), method: :patch, class: "kb-chrome-link"
    - if @can_manage
      = form_with url: notebook_notebook_memos_path(@notebook), method: :post, class: "mt-3 flex min-w-0 flex-col gap-2", data: { controller: "memo-search-picker", memo_search_picker_search_url_value: available_memos_notebook_path(@notebook), action: "submit->memo-search-picker#submitForm" } do
        = render "notebooks/memo_picker_field", notebook: @notebook, placeholder: "メモを追加…"
        = submit_tag "追加", class: "kb-chrome-btn-primary kb-btn-xs kb-btn-full", disabled: true, data: { memo_search_picker_target: "submit", theme_slot: "btn-primary" }
  .kb-notebook-sidebar-scroll.min-h-0.flex-1.overflow-y-auto.px-2.py-2
    = render "notebooks/memo_tree", notebook: @notebook
  - if @can_manage
    dialog#notebook_memo_picker_dialog.notebook-memo-picker-dialog.kb-modal-panel.rounded-lg.p-0 aria-labelledby="notebook-memo-picker-dialog-title" data-notebook-memo-picker-dialog-target="dialog" data-action="click->notebook-memo-picker-dialog#backdropClick close->notebook-memo-picker-dialog#restoreFocus"
      .flex.items-center.justify-between.border-b.kb-border.px-4.py-3
        h2#notebook-memo-picker-dialog-title.text-base.font-semibold.kb-text-primary 既存メモを追加
        button.kb-text-muted.hover:opacity-80 type="button" data-action="notebook-memo-picker-dialog#close" aria-label="閉じる" ×
      = form_with url: notebook_notebook_memos_path(@notebook), method: :post, class: "w-full space-y-3 p-4", data: { action: "submit->notebook-memo-picker-dialog#submit" } do
        = hidden_field_tag :parent_id, nil, data: { notebook_memo_picker_dialog_target: "parentId" }
        = hidden_field_tag :memo_id, nil, data: { notebook_memo_picker_dialog_target: "memoId" }
        = label_tag :notebook_dialog_memo_picker, "追加する既存メモを検索", class: "sr-only"
        .flex.min-w-0.items-center.gap-2
          = search_field_tag :memo_query, nil, id: "notebook_dialog_memo_picker", placeholder: "タイトル・本文で検索", autocomplete: "off", class: "kb-input kb-input-md min-w-0 flex-1", data: { notebook_memo_picker_dialog_target: "query", action: "input->notebook-memo-picker-dialog#queryInput" }
          = button_tag type: "submit", class: "kb-toolbar-btn h-9 w-9 shrink-0 justify-center p-0", disabled: true, title: "追加", aria: { label: "追加" }, data: { notebook_memo_picker_dialog_target: "submit" } do
            i.h-4.w-4 aria-hidden="true" data-lucide="plus"
          button.kb-toolbar-btn.h-9.w-9.shrink-0.justify-center.p-0 type="button" title="キャンセル" aria-label="キャンセル" data-action="notebook-memo-picker-dialog#close"
            i.h-4.w-4 aria-hidden="true" data-lucide="x"
        .max-h-64.overflow-y-auto.rounded-md.border.kb-border data-notebook-memo-picker-dialog-target="results"
          p.px-3.py-2.text-sm.kb-text-secondary 検索してください

- content_for :title, "編集 · #{@notebook.title}"

.mb-6
  h1.text-xl.font-semibold.kb-text-primary ノートブックを編集

= render "form", notebook: @notebook, submit_label: "保存"

section.mt-10
  h2.text-base.font-semibold.kb-text-primary メモの追加
  = form_with url: notebook_notebook_memos_path(@notebook), method: :post, class: "mt-3 flex flex-wrap items-end gap-2", data: { controller: "memo-search-picker", memo_search_picker_search_url_value: available_memos_notebook_path(@notebook), action: "submit->memo-search-picker#submitForm" } do
    div.min-w-[min(100%,20rem)].flex-1
      = label_tag :memo_query, "メモ", class: kb_label
      = render "notebooks/memo_picker_field", notebook: @notebook, picker_id: "notebook_edit_memo_picker", placeholder: "タイトル・本文で検索"
    = submit_tag "追加", class: "kb-chrome-btn-primary kb-btn-sm", disabled: true, data: { memo_search_picker_target: "submit", theme_slot: "btn-primary" }

  - if @notebook_memos.any?
    h3.mt-8.text-sm.font-semibold.kb-text-primary 含まれるメモ
    ul.mt-3 class="divide-y divide-[var(--kb-border)] rounded-md border kb-border"
      - @notebook_memos.each do |entry|
        li.flex.items-center.justify-between.gap-3.px-3.py-2
          span.min-w-0.truncate = entry.memo.title
          = button_to "外す", notebook_notebook_memo_path(@notebook, entry.memo), method: :delete, class: "shrink-0 text-sm text-red-600 hover:text-red-800"

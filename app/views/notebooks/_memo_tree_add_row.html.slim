ruby:
  label = parent_entry ? "「#{@notebook.display_label_for_memo(parent_entry)}」と同じ階層に新規メモを追加" : "最上位に新規メモを追加"
  params = parent_entry ? { parent_id: parent_entry.parent_id } : {}
  parent_id = parent_entry&.parent_id
  search_label = parent_entry ? "「#{@notebook.display_label_for_memo(parent_entry)}」と同じ階層に既存メモを追加" : "最上位に既存メモを追加"

li.kb-notebook-tree-add-row
  .flex.h-7.w-full.items-center.justify-center.gap-1
    = button_to create_blank_notebook_notebook_memos_path(@notebook),
      method: :post,
      params: params,
      form_class: "contents",
      title: label,
      aria: { label: label },
      class: "kb-notebook-tree-add-button inline-flex h-7 w-7 cursor-pointer items-center justify-center border-0 bg-transparent p-0" do
      i.h-4.w-4 aria-hidden="true" data-lucide="plus"
    button.kb-notebook-tree-search-button.inline-flex.h-7.w-7.cursor-pointer.items-center.justify-center.border-0.bg-transparent.p-0 type="button" title=search_label aria-label=search_label data-action="notebook-memo-picker-dialog#open" data-notebook-memo-picker-dialog-parent-id-param=parent_id
      i.h-4.w-4 aria-hidden="true" data-lucide="search"

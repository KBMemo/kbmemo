ruby:
  row_actions = []
  row_actions << "dragstart->notebook-memo-tree#entryDragStart dragend->notebook-memo-tree#entryDragEnd" if can_manage
  row_actions << row_drop.map { |key, val| "#{key}->#{val}" }.join(" ") if row_drop
  row_action = row_actions.presence&.join(" ")
  row_classes = "flex min-w-0 flex-1 items-center gap-0.5"
  row_classes += " cursor-grab" if can_manage

div class=row_classes data-notebook-memo-row="" data-notebook-memo-id=entry.id data-parent-id=entry.parent_id data-position=entry.position draggable=(can_manage ? "true" : nil) title=(can_manage ? "ドラッグして順序・階層を変更" : nil) data-action=row_action
  = link_to @notebook.display_label_for_memo(entry),
    notebook_memo_path_for_viewer(@notebook, entry.memo),
    class: notebook_memo_tree_row_classes(entry, selected_memo: @selected_memo),
    draggable: "false"
  - if can_manage
    = button_to create_blank_notebook_notebook_memos_path(@notebook), method: :post, params: { parent_id: entry.id }, form_class: "contents", draggable: "false", title: "子メモを追加", class: "kb-notebook-tree-row-action shrink-0 inline-flex h-6 w-6 cursor-pointer items-center justify-center border-0 bg-transparent p-0 kb-text-subtle hover:kb-text-secondary" do
      i class="h-3.5 w-3.5" aria-hidden="true" data-lucide="plus"
    - search_label = "「#{@notebook.display_label_for_memo(entry)}」の子階層に既存メモを追加"
    button.kb-notebook-tree-row-action.kb-notebook-tree-row-search-button.shrink-0.inline-flex.h-6.w-6.cursor-pointer.items-center.justify-center.border-0.bg-transparent.p-0.kb-text-subtle.hover:kb-text-secondary type="button" draggable="false" title=search_label aria-label=search_label data-action="notebook-memo-picker-dialog#open:stop" data-notebook-memo-picker-dialog-parent-id-param=entry.id
      i.h-3.5.w-3.5 aria-hidden="true" data-lucide="search"

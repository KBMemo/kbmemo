= form_with model: @memo_directory, class: "space-y-5" do |f|
  - if @memo_directory.errors.any?
    .rounded-md.border.border-red-200.bg-red-50.px-4.py-3.text-sm.text-red-900
      ul.list-inside.list-disc
        - @memo_directory.errors.full_messages.each do |msg|
          li = msg

  - unless @memo_directory.persisted?
    div
      = f.label :path_segment, "識別子（Git 上のフォルダ名）", class: "mb-1 block text-sm font-medium text-zinc-800"
      = f.text_field :path_segment, autocomplete: "off", placeholder: "work", class: memo_form_underline_input("font-mono text-sm")
      p.mt-1.text-xs.text-zinc-500 英小文字・数字・ハイフンのみ。作成後は変更できません。

  - if @memo_directory.persisted? && @memo_directory.root?
    / ルートの親は変更不可
  - else
    div
      = f.label :parent_id, "親ディレクトリ", class: "mb-1 block text-sm font-medium text-zinc-800"
      - parent_pairs = memo_directory_tree_select_option_pairs(@memo_directory_parent_options, root_option_label: "（最上位）")
      = f.select :parent_id, options_for_select(parent_pairs, @memo_directory.parent_id), {}, class: memo_form_underline_input("font-sans w-full max-w-xl")
      p.mt-1.text-xs.text-zinc-500 一覧・Git 上の階層が変わります。字下げは階層の目安です。移動できないフォルダはポリシーで制限されます。

  div
    = f.label :label, "ラベル（一覧表示名）", class: "mb-1 block text-sm font-medium text-zinc-800"
    = f.text_field :label, autocomplete: "off", class: memo_form_underline_input
    p.mt-1.text-xs.text-zinc-500 未入力のときは識別子を表示します（ルート以外）。

  .flex.gap-3.pt-2
    = f.submit(@memo_directory.persisted? ? "更新" : "作成", class: "rounded-md bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-800")
    = link_to "一覧へ", memo_directories_path, class: "rounded-md border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-800 hover:bg-zinc-50"

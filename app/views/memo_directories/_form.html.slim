ruby:
  dialog_mode = local_assigns[:dialog]
  lock_parent = local_assigns[:lock_parent]
  form_data = {}
  if dialog_mode
    form_data[:action] =
      "turbo:submit-start->memo-directory-dialog#submitStart turbo:submit-end->memo-directory-dialog#submitEnd"
  end

= form_with model: @memo_directory, class: "space-y-5", data: form_data do |f|
  = hidden_field_tag :dialog, "1" if dialog_mode
  = hidden_field_tag :board_picker, "1" if params[:board_picker].present?

  - if @memo_directory.errors.any?
    .rounded-md.border.border-red-200.bg-red-50.px-4.py-3.text-sm.text-red-900
      ul.list-inside.list-disc
        - @memo_directory.errors.full_messages.each do |msg|
          li = msg

  - unless @memo_directory.persisted?
    div
      = f.label :path_segment, "識別子（Git 上のフォルダ名）", class: "mb-1 block text-sm font-medium kb-text-primary"
      = f.text_field :path_segment, autocomplete: "off", placeholder: "work", class: memo_form_underline_input("font-mono text-sm")
      p.mt-1.text-xs.kb-text-muted 英小文字・数字・ハイフンのみ。作成後は変更できません。

  - if @memo_directory.persisted? && @memo_directory.root?
    / ルートの親は変更不可
  - elsif lock_parent && @memo_directory.parent
    = f.hidden_field :parent_id, value: @memo_directory.parent_id
    .text-sm.kb-text-secondary
      span.font-medium.kb-text-primary 親ディレクトリ：
      = memo_directory_path_from_root_label(@memo_directory.parent)
  - elsif @memo_directory.parent_selectable?
    div
      = render "parent_picker", f: f
      p.mt-1.text-xs.kb-text-muted 一覧・Git 上の階層が変わります。Home / Share / Public の直下には移動できません。
  - elsif @memo_directory.parent
    .text-sm.kb-text-secondary
      span.font-medium.kb-text-primary 親ディレクトリ：
      = memo_directory_path_from_root_label(@memo_directory.parent)
      p.mt-1.text-xs.kb-text-muted 最上位直下のフォルダは親を変更できません。

  div
    = f.label :label, "ラベル（一覧表示名）", class: "mb-1 block text-sm font-medium kb-text-primary"
    = f.text_field :label, autocomplete: "off", class: memo_form_underline_input
    p.mt-1.text-xs.kb-text-muted 未入力のときは識別子を表示します（ルート以外）。

  .flex.gap-3.pt-2
    = f.submit(@memo_directory.persisted? ? "更新" : "作成", class: "kb-chrome-btn-primary kb-btn-sm")
    - if dialog_mode
      button type="button" class="kb-action-btn kb-hover-row" data-action="click->memo-directory-dialog#cancel" キャンセル
    - else
      = link_to "一覧へ", memo_directories_path, class: "kb-action-btn kb-hover-row"

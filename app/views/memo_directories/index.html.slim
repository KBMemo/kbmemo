- content_for :title, "ディレクトリ一覧"

- content_for :memos_editor do
  .max-w-2xl
    .mb-6
      h1.text-xl.font-semibold.text-zinc-900 ディレクトリ
    - if @memo_directories.any?
      table.w-full.border-collapse.text-sm
        thead.border-b.border-zinc-200.text-left.text-xs.uppercase.text-zinc-500
          tr
            th.py-2.pr-3 パス
            th.py-2.pr-3 ラベル
            th.py-2
        tbody.divide-y.divide-zinc-100
          - @memo_directories.each do |d|
            tr class=(d.directory_list_readonly? ? "text-zinc-500" : nil)
              td.py-2.pr-3.font-mono.text-xs = d.root? ? "（ルート）" : d.full_path
              td.py-2.pr-3 = d.display_name
              td.py-2.text-right
                - if d.directory_list_readonly?
                  span.text-xs.text-zinc-400 読み取り専用
                - else
                  = link_to "子を追加", new_memo_directory_path(parent_id: d.id), class: "text-zinc-600 hover:text-zinc-900"
                  = " · "
                  - if policy(d).update?
                    = link_to "編集", edit_memo_directory_path(d), class: "text-zinc-600 hover:text-zinc-900"
                  - if policy(d).destroy?
                    = " · "
                    = button_to "削除", memo_directory_path(d), method: :delete, form: { data: { turbo_confirm: "「#{d.display_name}」を削除しますか？" } }, class: "text-red-600 hover:text-red-800"
    - else
      p.text-sm.text-zinc-500 ディレクトリがありません。

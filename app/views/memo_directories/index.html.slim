- content_for :title, "ディレクトリ一覧"

- content_for :memos_editor do
  .max-w-2xl
    .mb-6
      h1.text-xl.font-semibold.kb-text-primary ディレクトリ
    - if @memo_directories.any?
      table class="#{kb_table}"
        thead.border-b.kb-border.text-left.text-xs.uppercase.kb-text-muted
          tr
            th.py-2.pr-3 パス
            th.py-2.pr-3 ラベル
            th.py-2
        tbody class="divide-y divide-[var(--kb-border)]"
          - @memo_directories.each do |d|
            tr class=(d.directory_list_readonly? ? "kb-text-muted" : nil)
              td.py-2.pr-3.font-mono.text-xs = d.root? ? "（ルート）" : d.full_path
              td.py-2.pr-3 = d.display_name
              td.py-2.text-right
                - if d.directory_list_readonly?
                  span.text-xs.kb-text-subtle 読み取り専用
                - else
                  = link_to "子を追加", new_memo_directory_path(parent_id: d.id), class: "kb-text-secondary hover:kb-text-primary"
                  = " · "
                  - if policy(d).update?
                    = link_to "編集", edit_memo_directory_path(d), class: "kb-text-secondary hover:kb-text-primary"
                  - if policy(d).destroy? && d.deletable?
                    = " · "
                    = button_to "削除", memo_directory_path(d), method: :delete, form: { data: { turbo_confirm: "「#{d.display_name}」を削除しますか？" } }, class: "kb-danger-action"
    - else
      p.text-sm.kb-text-muted ディレクトリがありません。

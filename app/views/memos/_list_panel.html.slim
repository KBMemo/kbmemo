ruby:
  list_panel_root = { class: "flex flex-col" }
  show_memo_dnd = @sidebar_view == "directory"
  list_panel_controllers = ["memo-directory-nav-open"]
  list_panel_controllers << "memo-directory-dnd" if show_memo_dnd
  list_panel_controllers << "memo-directory-dialog"
  list_panel_root[:data] = { controller: list_panel_controllers.join(" ") }
#memos_list_panel *list_panel_root
  .flex-shrink-0.border-b.kb-border.px-3.py-3
    .kb-sidebar-tab-bar.mb-2.flex.rounded-lg.p-0.5
      = link_to "ディレクトリ", memos_sidebar_directory_tab_path, class: memo_sidebar_view_tab_classes("directory"), draggable: "false"
      = link_to "タグ", memos_sidebar_tag_tab_path, class: memo_sidebar_view_tab_classes("tag"), draggable: "false"
      = link_to "検索", memos_sidebar_search_tab_path, class: memo_sidebar_view_tab_classes("search"), draggable: "false"
      = link_to "履歴", memos_sidebar_history_tab_path, class: memo_sidebar_view_tab_classes("history"), draggable: "false"
    - if (open_memo = memo_sidebar_open_memo) && (dir = open_memo.memo_directory) && !dir.root?
      .mb-2.min-w-0.text-sm.kb-text-secondary
        span.sr-only 保存先
        = link_to memo_directory_path_from_root_label(dir),
          memo_sidebar_open_memo_path(open_memo, memo_directory_id: dir.id),
          class: "block truncate underline decoration-[var(--kb-border-strong)] hover:text-[var(--kb-text-primary)]",
          title: "サイドバーでこのディレクトリを表示"
    - if @sidebar_view == "directory"
      - nav_dir_children = memo_directory_nav_children_index(@memo_directories_for_nav || [])
      ul.mb-2.space-y-0.5
        - memo_directory_nav_tree_roots(@memo_directories_for_nav || [], nav_dir_children).each do |dir|
          = render "memos/memo_directory_nav_branch", dir: dir, by_parent: nav_dir_children
    - elsif @sidebar_view == "tag"
      - tags = @tags_for_nav || []
      - if tags.any?
        ul.mb-2.space-y-0.5
          - tags.each do |tag|
            li
              = link_to memos_path(sidebar_view: "tag", tag_id: tag.id), class: memo_tag_nav_link_classes(tag), draggable: "false" do
                span.truncate = tag.name
      - else
        p.mb-2.text-xs.kb-text-secondary タグがまだありません。メモの編集画面でタグを付けられます。
      = link_to "タグを管理…", tags_path, class: "mb-2 inline-block text-xs kb-text-secondary underline decoration-[var(--kb-border-strong)] hover:text-[var(--kb-text-primary)]"
    - elsif @sidebar_view == "search"
      .mb-2 data-controller="memo-search"
        = form_tag memos_path, method: :get, class: "flex min-w-0 gap-1", data: { memo_search_target: "form", turbo: "false" } do
          = hidden_field_tag :sidebar_view, "search"
          = search_field_tag :q, @memo_search_query, placeholder: "タイトル・本文を検索", autocomplete: "off", class: memo_sidebar_search_input, data: { memo_search_target: "input", action: "input->memo-search#submitSearch" }
          - if @memo_search_query.present?
            button.kb-chrome-btn-secondary.shrink-0.px-2.py-1.5.text-xs type="button" data-action="memo-search#clear" クリア
      p.mb-2.text-xs.kb-text-secondary タイトルと本文を横断して検索します。
    - elsif @sidebar_view == "history"
      p.mb-2.text-xs.kb-text-secondary 最近開いたメモを表示します（最大 #{MemoViewHistory::MAX_PER_ACCOUNT} 件）。
    .mb-2.flex.min-w-0.items-center.justify-between.gap-2
      - if @sidebar_view == "search" && @memo_search_query.present?
        p.truncate.text-xs.font-medium.uppercase.tracking-wide.kb-text-muted
          | 検索結果
          span.ml-1.font-normal.normal-case.kb-text-subtle = "「#{h(@memo_search_query)}」"
      - elsif @sidebar_view == "history"
        p.truncate.text-xs.font-medium.uppercase.tracking-wide.kb-text-muted 表示履歴
      - else
        p.truncate.text-xs.font-medium.uppercase.tracking-wide.kb-text-muted メモ一覧
      - if @sidebar_view == "directory"
        .flex.shrink-0.items-center.gap-1
          = link_to "管理", manage_memos_path(memo_directory_id: (@current_memo_directory&.root? ? nil : @current_memo_directory&.id)), class: "text-xs kb-text-secondary underline decoration-[var(--kb-border-strong)] hover:text-[var(--kb-text-primary)]", title: "ディレクトリ・メモ管理画面を開く", data: { turbo: false }
          details.relative.shrink-0
            summary class=kb_hint_trigger
              i[data-lucide="circle-help" class="h-4 w-4"]
              span.sr-only メモを別ディレクトリへ移動する方法
            div class="absolute right-0 top-6 z-30 w-72 #{kb_hint_popover}"
              | 左の縞アイコンをドラッグして、上のフォルダ名に置くと移動します。
    = link_to new_memo_path_with_current_directory, class: memo_sidebar_link_classes(:new), data: { turbo: false } do
      span.mr-1.kb-text-muted +
      span 新規メモ
  = render "memos/sidebar_memo_list_container"
  dialog.memo-directory-dialog.kb-modal-panel.rounded-lg.p-0 class="max-h-[85vh] overflow-y-auto" data-memo-directory-dialog-target="dialog" data-action="click->memo-directory-dialog#backdropClick"
    #memo_directory_dialog_body.p-6 data-memo-directory-dialog-target="body"

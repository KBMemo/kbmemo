ruby:
  list_panel_root = { class: "flex min-h-0 flex-1 flex-col overflow-hidden" }
  list_panel_controllers = ["memo-directory-nav-open"]
  list_panel_root[:data] = { controller: list_panel_controllers.join(" ") }
#memos_list_panel *list_panel_root
  .flex-shrink-0.border-b.kb-border.px-3.py-3
    .kb-sidebar-tab-bar.mb-2.flex.rounded-lg.p-0.5
      = link_to "履歴", memos_sidebar_history_tab_path, class: memo_sidebar_view_tab_classes("history"), draggable: "false"
      = link_to "タグ", memos_sidebar_tag_tab_path, class: memo_sidebar_view_tab_classes("tag"), draggable: "false"
      = link_to "検索", memos_sidebar_search_tab_path, class: memo_sidebar_view_tab_classes("search"), draggable: "false"
      = link_to "ディレクトリ", memos_sidebar_directory_tab_path, class: memo_sidebar_view_tab_classes("directory"), draggable: "false"
    - if @sidebar_view == "directory"
      = form_tag memos_path, method: :get, class: "relative mb-2", data: { turbo: false, controller: "memo-directory-path-search", memo_directory_path_search_target: "form" } do
        = hidden_field_tag :sidebar_view, "directory"
        = label_tag :memo_directory_path, "選択ディレクトリ", class: "mb-1 block text-xs font-medium kb-text-secondary"
        .flex.min-w-0.items-center.gap-1
          = search_field_tag :memo_directory_path,
            memo_sidebar_directory_path_value,
            autocomplete: "off",
            spellcheck: "false",
            role: "combobox",
            class: "kb-input kb-input-xs min-w-0 flex-1 font-mono",
            aria: { autocomplete: "list", controls: "memo-sidebar-directory-path-options", expanded: "false", invalid: (@memo_directory_path_invalid ? "true" : nil), describedby: (@memo_directory_path_invalid ? "memo-directory-path-error" : nil) },
            data: { memo_directory_path_search_target: "input", action: "input->memo-directory-path-search#input focus->memo-directory-path-search#focus blur->memo-directory-path-search#closeLater keydown->memo-directory-path-search#keydown" }
          = button_tag "移動", type: "submit", class: "kb-chrome-btn-secondary kb-btn-xs shrink-0"
        #memo-sidebar-directory-path-options.kb-tag-search-options.hidden role="listbox" data-memo-directory-path-search-target="options"
          button#memo-directory-path-option-root.kb-tag-search-option.hidden type="button" role="option" aria-selected="false" data-directory-path="/" data-search-text="/ ルート" data-memo-directory-path-search-target="option" data-action="mousedown->memo-directory-path-search#keepOpen click->memo-directory-path-search#select"
            | /
          - (@memo_directories_for_nav || []).reject(&:root?).each do |directory|
            - directory_path = "/#{directory.full_path}"
            button.kb-tag-search-option.hidden id="memo-directory-path-option-#{directory.id}" type="button" role="option" aria-selected="false" title=directory.labeled_path_from_root data-directory-path=directory_path data-search-text="#{directory_path} #{directory.labeled_path_from_root}" data-memo-directory-path-search-target="option" data-action="mousedown->memo-directory-path-search#keepOpen click->memo-directory-path-search#select"
              = directory_path
        - if @memo_directory_path_invalid
          p#memo-directory-path-error.mt-1.text-xs.kb-status-danger
            | ディレクトリが見つかりません。
      - nav_dir_children = memo_directory_nav_children_index(@memo_directories_for_nav || [])
      .kb-memo-directory-tree-scroll.mb-2
        ul.list-none.space-y-0.5.p-0
          - memo_directory_nav_tree_roots(@memo_directories_for_nav || [], nav_dir_children).each do |dir|
            = render "memos/memo_directory_nav_branch", dir: dir, by_parent: nav_dir_children
    - elsif @sidebar_view == "tag"
      - tags = @tags_for_nav || []
      - if tags.any?
        search.kb-tag-search.mb-2 data-controller="memo-tag-search"
          = form_tag memos_sidebar_tag_search_path, method: :get, class: "flex min-w-0 gap-1", data: { memo_tag_search_target: "form", action: "submit->memo-tag-search#submit" } do
            = hidden_field_tag :sidebar_view, "tag"
            - @current_tags.each do |tag|
              = hidden_field_tag "tag_ids[]", tag.id, data: { memo_tag_search_target: "selectedTag", tag_id: tag.id }
            - @excluded_tags.each do |tag|
              = hidden_field_tag "excluded_tag_ids[]", tag.id, data: { memo_tag_search_target: "selectedTag", tag_id: tag.id }
            = label_tag :tag_query, "タグを検索", class: "sr-only"
            = search_field_tag :tag_query, nil, placeholder: "タグを追加", autocomplete: "off", role: "combobox", aria: { autocomplete: "list", controls: "memo-sidebar-tag-options", expanded: "false" }, class: memo_sidebar_search_input, data: { memo_tag_search_target: "input", action: "input->memo-tag-search#input focus->memo-tag-search#input blur->memo-tag-search#closeLater keydown->memo-tag-search#keydown" }
            button type="button" class="kb-chrome-btn-secondary kb-btn-xs shrink-0#{' hidden' if @current_tags.empty? && @excluded_tags.empty?}" data-memo-tag-search-target="clear" data-action="memo-tag-search#clear" クリア
          - if @current_tags.any? || @excluded_tags.any?
            ul.mt-2.flex.flex-wrap.gap-1.list-none.p-0 aria-label="選択中のタグ"
              - @current_tags.each do |tag|
                li.kb-tag-condition
                  = link_to tag.name, memos_sidebar_tag_filter_path(@current_tags - [tag], @excluded_tags + [tag]), class: "kb-list-tag kb-inline-link", title: "#{tag.name} をNOT条件にする"
                  = link_to "×", memos_sidebar_tag_filter_path(@current_tags - [tag], @excluded_tags), class: "kb-tag-condition-remove", title: "#{tag.name} を条件から外す", aria: { label: "#{tag.name} を条件から外す" }
              - @excluded_tags.each do |tag|
                li.kb-tag-condition
                  = link_to "NOT #{tag.name}", memos_sidebar_tag_filter_path(@current_tags + [tag], @excluded_tags - [tag]), class: "kb-list-tag kb-list-tag-negative kb-inline-link", title: "#{tag.name} をAND条件に戻す"
                  = link_to "×", memos_sidebar_tag_filter_path(@current_tags, @excluded_tags - [tag]), class: "kb-tag-condition-remove", title: "#{tag.name} を条件から外す", aria: { label: "#{tag.name} を条件から外す" }
          #memo-sidebar-tag-options.kb-tag-search-options.hidden role="listbox" data-memo-tag-search-target="options"
            - tags.each do |tag|
              button.kb-tag-search-option type="button" role="option" data-memo-tag-search-target="option" data-tag-id=tag.id data-tag-name=tag.name data-action="mousedown->memo-tag-search#keepOpen click->memo-tag-search#select"
                = tag.name
      - else
        p.mb-2.text-xs.kb-text-secondary タグがまだありません。メモの編集画面でタグを付けられます。
    - elsif @sidebar_view == "search"
      search.mb-2 data-controller="memo-search" data-memo-search-list-url-value=sidebar_memo_list_memos_path
        = form_tag memos_path, method: :get, class: "flex min-w-0 gap-1", data: { memo_search_target: "form", action: "submit->memo-search#submitSearch", turbo: false } do
          = hidden_field_tag :sidebar_view, "search"
          = label_tag :q, "タイトル・本文を検索", class: "sr-only"
          = search_field_tag :q, @memo_search_query, placeholder: "タイトル・本文を検索", autocomplete: "off", class: memo_sidebar_search_input, data: { memo_search_target: "input", action: "input->memo-search#queueSearch" }
          button type="button" class="kb-chrome-btn-secondary kb-btn-xs shrink-0#{' hidden' unless @memo_search_query.present?}" data-memo-search-target="clear" data-action="memo-search#clear" クリア
      p.mb-2.text-xs.kb-text-secondary タイトルと本文を横断して検索します。
    - unless @sidebar_view.in?(%w[history tag])
      .mb-2.flex.min-w-0.items-center.justify-between.gap-2
        - if @sidebar_view == "search" && @memo_search_query.present?
          p#memo_sidebar_list_heading.truncate.text-xs.font-medium.uppercase.tracking-wide.kb-text-muted
            | 検索結果
            span.ml-1.font-normal.normal-case.kb-text-subtle = "「#{h(@memo_search_query)}」"
        - elsif @sidebar_view == "search"
          p#memo_sidebar_list_heading.truncate.text-xs.font-medium.uppercase.tracking-wide.kb-text-muted メモ一覧
        - else
          p#memo_sidebar_list_heading.truncate.text-xs.font-medium.uppercase.tracking-wide.kb-text-muted メモ一覧
    .kb-sidebar-create-row
      = link_to new_memo_path, class: memo_sidebar_link_classes(:new), data: { turbo: false } do
        span +新規
      - if @sidebar_memo_templates.any?
        .relative data-controller="user-menu"
          button#memo-template-create-trigger.kb-sidebar-template-trigger.inline-flex.items-center.gap-1 type="button" data-user-menu-target="button" data-action="user-menu#toggle" aria-expanded="false" aria-haspopup="true"
            span Templateから作成
            svg.h-4.w-4.flex-shrink-0.kb-text-muted xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"
              path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"
          #memo-template-create-menu.kb-menu-panel.kb-sidebar-template-menu.absolute.right-0.top-full.z-50.mt-1.hidden.overflow-y-auto.rounded-md.py-1.text-sm data-user-menu-target="panel" role="menu"
            - @sidebar_memo_templates.each do |template|
              = link_to template.name, new_memo_path(template_id: template.id), class: "kb-menu-item block truncate px-3 py-2", role: "menuitem", title: template.name, data: { turbo: false }
      - else
        button.kb-sidebar-template-trigger type="button" disabled=true title="利用できるテンプレートがありません"
          | Templateから作成
  #memo_sidebar_memo_list_scroll.kb-memo-sidebar-scroll.min-h-0.flex-1.overflow-y-auto.pb-4
    = render "memos/sidebar_memo_list_container"

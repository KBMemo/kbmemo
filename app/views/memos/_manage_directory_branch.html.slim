ruby:
  children = (by_parent[dir.id] || [])
  has_children = children.any?
  is_current = current_directory&.id == dir.id
  selectable = !(dir.root? || dir.top_level_bucket?)

li.min-w-0
  - if selectable
    = link_to manage_memos_path(memo_directory_id: dir.id), class: "block min-w-0 flex-1 truncate rounded-md px-2 py-1 text-sm #{is_current ? 'kb-sidebar-nav is-active' : 'kb-hover-row kb-text-secondary'}", data: { turbo: false } do
      span.truncate = dir.display_name
  - else
    span.block.min-w-0.truncate.px-2.py-1.text-xs.font-medium.uppercase.tracking-wide.kb-text-muted = dir.display_name
  - if has_children
    ul.mt-0.5.space-y-0.5.border-l.kb-border.ml-2.pl-2
      - children.each do |child|
        = render "memos/manage_directory_branch", dir: child, by_parent: by_parent, current_directory: current_directory

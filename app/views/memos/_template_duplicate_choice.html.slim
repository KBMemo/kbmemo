section.py-4 aria-labelledby="template-duplicate-title"
  h1#template-duplicate-title.text-lg.font-semibold.kb-text-primary 同じタイトルのメモがあります
  p.mt-2.text-sm.kb-text-secondary
    = "「#{@memo.title}」はすでに作成されています。"
  .mt-4.flex.flex-wrap.items-center.gap-2
    = link_to "既存のメモを開く", memo_path(@existing_template_memo), class: "kb-chrome-btn-primary kb-btn-md", data: { theme_slot: "btn-primary" }
    = link_to "追加作成", new_memo_path(template_id: @selected_memo_template.id, duplicate: "create"), class: "kb-chrome-btn-secondary kb-btn-md", data: { turbo: false }

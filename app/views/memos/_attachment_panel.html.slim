/ locals: (memo:, body: nil)
- return unless memo.image_assets_uploadable?
- entries = memo_attachment_entries(memo, body: body)
- can_manage = policy(memo).update?

#memo-attachment-panel class="hidden pt-1 text-[0.8em]" data-memo-attachments-target="panel"
  - if entries.empty?
    p class="px-1 py-2 kb-text-muted" 添付ファイルはありません
  - else
    ul class="kb-list-box"
      - entries.each do |entry|
        li class="memo-attachment-row grid grid-cols-1 gap-2 px-2 py-2 sm:grid-cols-[minmax(0,1fr)_auto]" data-memo-attachments-target="row"
          .flex.min-w-0.flex-wrap.items-center.gap-x-2.gap-y-1
            span class="font-mono kb-text-primary"= entry.name
            .flex.flex-wrap.items-center.gap-1
              - if entry.svg_missing
                span class="rounded bg-amber-50 px-1.5 py-0.5 text-amber-800" SVG無し
              - unless entry.referenced
                span class="rounded bg-[var(--kb-bg-muted)] px-1.5 py-0.5 kb-text-secondary" 未使用
          .flex.flex-wrap.items-center.gap-1.sm:justify-end
            - if entry.edit_url
              = link_to "編集",
                entry.edit_url,
                class: "rounded border kb-border bg-white px-2 py-0.5 kb-text-secondary kb-hover-row",
                target: "_blank",
                rel: "noopener"
            - unless entry.referenced
              button class="rounded border kb-border bg-white px-2 py-0.5 kb-text-secondary kb-hover-row" type="button" data-action="memo-attachments#insert" data-memo-attachments-text-param=entry.insert_text
                | 挿入
            - if can_manage && entry.delete_path
              button class="rounded border border-red-200 bg-white px-2 py-0.5 text-red-700 hover:bg-red-50" type="button" data-action="memo-attachments#remove" data-destroy-path=entry.delete_path data-memo-id=memo.id data-destroy-name=entry.name
                | 削除

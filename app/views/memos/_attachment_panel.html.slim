/ locals: (memo:, body: nil)
- return unless memo.image_assets_uploadable?
- entries = memo_attachment_entries(memo, body: body)
- can_manage = policy(memo).update?

#memo-attachment-panel class="memo-attachment-panel hidden pt-1" data-memo-attachments-target="panel"
  - if entries.empty?
    p class="px-1 py-2 kb-text-muted" 添付ファイルはありません
  - else
    ul class="kb-list-box"
      - entries.each do |entry|
        li class="memo-attachment-row grid gap-2 px-2 py-2" data-memo-attachments-target="row"
          .flex.min-w-0.flex-wrap.items-center.gap-x-2.gap-y-1
            span class="font-mono kb-text-primary"= entry.name
            .flex.flex-wrap.items-center.gap-1
              - if entry.svg_missing
                span class="kb-badge kb-badge-warning" SVG無し
              - unless entry.referenced
                span class="kb-badge kb-badge-muted" 未使用
          .flex.flex-wrap.items-center.gap-1.sm:justify-end
            - if entry.edit_url
              = link_to "編集",
                entry.edit_url,
                class: "kb-action-btn kb-action-btn-sm kb-hover-row",
                target: "_blank",
                rel: "noopener"
            - if entry.kind == :document
              = link_to "ダウンロード",
                asset_memo_path(memo, entry.relative_path),
                class: "kb-action-btn kb-action-btn-sm kb-hover-row"
            - unless entry.referenced
              button class="kb-action-btn kb-action-btn-sm kb-hover-row" type="button" data-action="memo-attachments#insert" data-memo-attachments-text-param=entry.insert_text
                | 挿入
            - if can_manage && entry.delete_path
              button class="kb-danger-btn kb-btn-xs" type="button" data-action="memo-attachments#remove" data-destroy-path=entry.delete_path data-memo-id=memo.id data-destroy-name=entry.name
                | 削除

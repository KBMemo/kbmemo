ruby:
  discard_btn_class = "rounded-md border border-amber-300 bg-amber-50 px-4 py-2 text-sm font-medium text-amber-950 hover:bg-amber-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2"
  discard_btn_class += " hidden" unless memo.display_as_draft?
  show_link_class = "kb-chrome-btn-secondary px-4 py-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--kb-border-strong)] focus-visible:ring-offset-2"
  show_link_class += " hidden" unless memo.file_committed_at.present? && !memo.display_as_draft?
  delete_btn_class = "rounded-md border border-red-200 bg-white px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-2"
  commit_btn_class = "kb-chrome-btn-primary px-4 py-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--kb-border-strong)] focus-visible:ring-offset-2"
  uncommitted = memo.file_committed_at.blank?
  memo_edit_form_id = local_assigns.fetch(:memo_edit_form_id) { dom_id(memo, :edit_form) }

#memo_form_actions.mt-4.flex.justify-end.gap-2
  - if uncommitted && memo.persisted?
    = button_to "削除", memo_path(memo, memo_sidebar_nav_query), method: :delete, form: { data: { turbo: false, turbo_confirm: "このメモを削除しますか？" } }, class: delete_btn_class
  - if memo.file_committed_at.present?
    button type="button" class=discard_btn_class data-memo-draft-target="discardDraftButton" data-action="memo-draft#discardDraft" title="ドラフトの変更を破棄し、最後に Git へコミットした内容を読み込みます"
      | ドラフトを破棄
  - if memo.persisted?
    = link_to "表示", memo_path(memo), class: show_link_class, data: { memo_draft_target: "showMemoLink" }
    button type="submit" form=memo_edit_form_id title="ファイルへ保存して、Gitに記録" data-memo-commit="true" class=commit_btn_class data-theme-slot="btn-primary"
      | コミット

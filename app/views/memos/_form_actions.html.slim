ruby:
  discard_btn_class = "kb-warning-btn kb-focus-ring"
  discard_btn_class += " hidden" unless memo.display_as_draft?
  show_link_class = "kb-chrome-btn-secondary kb-btn-md kb-focus-ring"
  show_link_class += " hidden" unless memo.file_committed_at.present? && !memo.display_as_draft?
  delete_btn_class = "kb-danger-btn kb-focus-ring"
  commit_btn_class = "kb-chrome-btn-primary kb-btn-md kb-focus-ring"
  commit_btn_class += " hidden" unless memo.persisted?
  uncommitted = memo.file_committed_at.blank?
  memo_edit_form_id = local_assigns.fetch(:memo_edit_form_id) { dom_id(memo, :edit_form) }

#memo_form_actions.mt-4.flex.flex-wrap.items-center.justify-end.gap-2
  - if memo.persisted? && memo.notebook.present? && policy(memo.notebook).show?
    = link_to notebook_path(memo.notebook, memo_id: memo.id), class: "kb-chrome-btn-secondary kb-btn-md kb-focus-ring mr-auto inline-flex items-center gap-1", title: "ノートブックに戻る" do
      i class="h-3.5 w-3.5" aria-hidden="true" data-lucide="arrow-left"
      span = "#{memo.notebook.title} に戻る"
  - if uncommitted && memo.persisted?
    = button_to "削除", memo_path(memo, memo_sidebar_nav_query), method: :delete, form: { data: { turbo_confirm: "このメモを削除しますか？" } }, class: delete_btn_class
  - if memo.file_committed_at.present?
    button type="button" class=discard_btn_class data-memo-draft-target="discardDraftButton" data-action="memo-draft#discardDraft" title="ドラフトの変更を破棄し、最後に Git へコミットした内容を読み込みます"
      | ドラフトを破棄
  - show_href = memo.persisted? ? memo_path(memo) : "#"
  = link_to "表示", show_href, class: show_link_class, data: { memo_draft_target: "showMemoLink", action: "mousedown->memo-draft#prepareShowNavigation" }
  button type="submit" form=memo_edit_form_id title="ファイルへ保存して、Gitに記録" data-memo-commit="true" class=commit_btn_class data-theme-slot="btn-primary" data-promote-hidden=("" unless memo.persisted?)
    | コミット

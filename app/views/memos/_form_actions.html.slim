ruby:
  discard_btn_class = "kb-warning-btn kb-form-action-icon kb-focus-ring"
  discard_btn_class += " hidden" unless memo.display_as_draft?
  show_link_class = "kb-chrome-btn-secondary kb-btn-md kb-focus-ring"
  show_link_class += " kb-form-action-icon"
  show_link_class += " hidden" unless memo.file_committed_at.present? && !memo.display_as_draft?
  delete_btn_class = "kb-danger-btn kb-form-action-icon kb-focus-ring"
  commit_btn_class = "kb-chrome-btn-primary kb-form-action-icon kb-focus-ring"
  commit_btn_class += " hidden" unless memo.persisted?
  uncommitted = memo.file_committed_at.blank?
  memo_edit_form_id = local_assigns.fetch(:memo_edit_form_id) { dom_id(memo, :edit_form) }

#memo_form_actions.mt-4.flex.flex-wrap.items-center.justify-end.gap-2
  - if memo.persisted? && memo.notebook.present? && policy(memo.notebook).show?
    = link_to notebook_path(memo.notebook, memo_id: memo.id), class: "kb-chrome-btn-secondary kb-btn-md kb-focus-ring mr-auto inline-flex items-center gap-1", title: "ノートブックに戻る" do
      i class="h-3.5 w-3.5" aria-hidden="true" data-lucide="arrow-left"
      span = "#{memo.notebook.title} に戻る"
  - if uncommitted && memo.persisted?
    = button_to memo_path(memo, memo_sidebar_nav_query), method: :delete, form: { data: { turbo_confirm: "このメモを削除しますか？" } }, class: delete_btn_class, title: "削除", aria: { label: "削除" }, data: { memo_context_action: "delete" } do
      i.h-4.w-4 aria-hidden="true" data-lucide="trash-2"
      span.sr-only 削除
  - if memo.file_committed_at.present?
    button type="button" class=discard_btn_class data-memo-draft-target="discardDraftButton" data-action="memo-draft#discardDraft" title="ドラフトを破棄" aria-label="ドラフトを破棄"
      i.h-4.w-4 aria-hidden="true" data-lucide="rotate-ccw"
      span.sr-only ドラフトを破棄
  - show_href = memo.persisted? ? memo_path(memo) : "#"
  = link_to show_href, class: show_link_class, title: "表示", aria: { label: "表示" }, data: { memo_draft_target: "showMemoLink", memo_context_action: "show", action: "mousedown->memo-draft#prepareShowNavigation" } do
    i.h-4.w-4 aria-hidden="true" data-lucide="eye"
    span.sr-only 表示
  button type="submit" form=memo_edit_form_id title="コミット" aria-label="コミット" data-memo-commit="true" data-memo-context-action="commit" class=commit_btn_class data-theme-slot="btn-primary" data-promote-hidden=("" unless memo.persisted?)
    i.h-4.w-4 aria-hidden="true" data-lucide="git-commit-horizontal"
    span.sr-only コミット

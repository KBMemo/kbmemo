- unless dir.directory_list_readonly?
  .flex.shrink-0.items-center.gap-0.5
    button type="button" class="inline-flex h-6 w-6 items-center justify-center rounded text-zinc-400 hover:bg-zinc-200 hover:text-zinc-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400" title="子ディレクトリを追加" aria-label="子ディレクトリを追加" data-action="click->memo-directory-dialog#openNew:stop" data-memo-directory-dialog-parent-id-param=dir.id
      i class="h-3.5 w-3.5" data-lucide="plus" aria-hidden="true"
    - if policy(dir).update?
      button type="button" class="inline-flex h-6 w-6 items-center justify-center rounded text-zinc-400 hover:bg-zinc-200 hover:text-zinc-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400" title="ディレクトリを編集" aria-label="ディレクトリを編集" data-action="click->memo-directory-dialog#openEdit:stop" data-memo-directory-dialog-id-param=dir.id
        i class="h-3.5 w-3.5" data-lucide="pencil" aria-hidden="true"
    - if policy(dir).destroy? && dir.deletable?
      button type="button" class="inline-flex h-6 w-6 items-center justify-center rounded text-zinc-400 hover:bg-red-100 hover:text-red-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400" title="ディレクトリを削除" aria-label="ディレクトリを削除" data-action="click->memo-directory-dialog#deleteDirectory:stop" data-memo-directory-dialog-id-param=dir.id data-memo-directory-dialog-name-param=dir.display_name
        i class="h-3.5 w-3.5" data-lucide="trash-2" aria-hidden="true"

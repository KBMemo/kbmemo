ruby:
  form_data = {
    controller: "memo-draft",
    action: "submit->memo-draft#preventSubmit keydown->memo-draft#suppressEnterSubmit memo-metadata-suggestions:apply->memo-draft#applyMetadataSuggestion",
    turbo: "false"
  }
  form_data[:memo_draft_draft_url_value] = draft_memo_path(memo, memo_sidebar_nav_query) if memo.persisted?
  form_data[:memo_draft_discard_draft_url_value] = revert_draft_memo_path(memo, memo_sidebar_nav_query) if memo.persisted? && memo.file_committed_at.present?
  form_data[:memo_draft_create_url_value] = memos_path unless memo.persisted?
  form_data[:turbo_cache] = "false" unless memo.persisted?
  form_data[:memo_draft_file_committed_value] = memo.file_committed_at.present?
  form_data[:memo_draft_memo_id_value] = memo.id if memo.persisted?
  form_data[:memo_draft_tag_catalog_value] = memo_tag_catalog_for_pills.to_json
  memo_edit_form_id = memo.persisted? ? dom_id(memo, :edit_form) : "new_memo_form"
  unless memo.persisted?
    initial_tag_list = local_assigns.fetch(:initial_tag_list, "").to_s
    form_data[:memo_draft_initial_form_value] = {
      title: memo_title_input_value(memo),
      body: memo.body.to_s,
      properties_yaml: "",
      tag_list: initial_tag_list,
      visibility: memo.visibility,
      memo_group_id: memo.memo_group_id.to_s,
      title_manual: memo.title_manual? ? "1" : "0"
    }.to_json
  end

= tag.div class: "memo-draft-shell", data: form_data do
  = form_with model: memo, class: "space-y-3", html: { id: memo_edit_form_id, data: { turbo: "false" } } do |f|
    = hidden_field_tag "memo[title_manual]", memo.title_manual ? "1" : "0", data: { memo_draft_target: "titleManualFlag" }
    - if memo.errors.any?
      .kb-alert.kb-alert-danger
        p.font-medium 保存できませんでした。
        ul.mt-2.list-inside.list-disc.space-y-1
          - memo.errors.full_messages.each do |message|
            li = message
  
    - if memo.persisted?
      .hidden.kb-alert.kb-alert-warning role="status" data-memo-draft-target="remoteNotice"
        span data-memo-draft-target="remoteNoticeText"
          | 別のタブでこのメモが保存されました。
        button.ml-2.kb-warning-btn.kb-btn-xs type="button" data-action="memo-draft#applyRemoteDraft"
          | 最新の本文を読み込む
  
    - if memo.persisted? && memo.account && memo.account_id != rodauth.rails_account&.id
      .memo-edit-author.mb-3.flex.items-center.gap-2.border-b.kb-border.pb-3
        = gravatar_image_tag(memo.account, size: 28, extra_class: "shrink-0", loading: "eager", fetchpriority: "low")
        div.min-w-0
          p.text-xs.kb-text-muted 作成者
          p.truncate.text-sm.font-medium.kb-text-primary = memo.account.display_name

    div
      = render "title_field", memo: memo
  
    .kb-form-disclosure-row
      details.kb-form-disclosure open=(memo.errors[:visibility].any? || memo.errors[:memo_group_id].any?)
        summary.kb-form-disclosure-summary 共有設定
        .kb-form-disclosure-panel
          = render "visibility_field", memo: memo, f: f

      details.kb-form-disclosure open=memo.errors[:properties_yaml].any?
        summary.kb-form-disclosure-summary プロパティ
        .kb-form-disclosure-panel
          = label_tag "memo_properties_yaml", "プロパティ（YAML）", class: "sr-only"
          = text_area_tag "memo[properties_yaml]", memo_properties_yaml_value(memo), rows: 4, placeholder: "priority: 1\nlabels:\n  - ideas", class: memo_form_underline_properties_textarea(memo), data: { memo_draft_target: "propertiesYaml", action: "input->memo-draft#propertiesInput compositionend->memo-draft#propertiesInput" }, aria: kb_field_error_aria(memo, :properties_yaml)
          - if memo.errors[:properties_yaml].any?
            p.mt-1.text-sm.kb-status-danger id=kb_field_error_id(memo, :properties_yaml) = memo.errors[:properties_yaml].first
  
    = render "tag_field", memo: memo, initial_tag_list: local_assigns[:initial_tag_list]
  
    div data-controller="expandable-hint" data-expandable-hint-expanded-value="false" data-expandable-hint-expand-label-value="Wiki リンクの説明を表示" data-expandable-hint-collapse-label-value="Wiki リンクの説明を閉じる"
      .mb-1.flex.w-full.items-center.gap-1
        = f.label :body, "本文（AsciiDoc）", id: "memo-body-label", class: "mb-0 block shrink-0 text-sm font-medium kb-text-primary"
        button.ml-auto.inline-flex.h-6.w-6.shrink-0.items-center.justify-center.rounded.kb-toolbar-btn type="button" data-expandable-hint-target="toggleButton" data-action="expandable-hint#toggle" aria-expanded="false" aria-controls="memo-wiki-link-hint" aria-label="Wiki リンクの説明を表示" title="Wiki リンクの説明を表示"
          span.leading-none data-expandable-hint-target="toggleIcon" aria-hidden="true"
            | ▼
      p#memo-wiki-link-hint.hidden.mb-1.text-xs.kb-text-muted data-expandable-hint-target="panel"
        | メモへの Wiki リンク:
        code.kb-text-secondary
          | [[相手メモのタイトル]]
        | 、
        code.kb-text-secondary
          | [[タイトル|表示名]]
        | 、
        code.kb-text-secondary
          | [[slug-123]]
        | （スラッグはメモ ID 付きで全体一意。ディレクトリを移してもリンクは有効。
        | 旧形式の
        code.kb-text-secondary
          | [[slug]]
        | や
        code.kb-text-secondary
          | [[home/u-1/work/slug-123]]
        | も解決できる場合があります）
      div class="memo-body-editor block w-full border-0 rounded-none bg-transparent border-b kb-border" data-theme-slot="memo-editor" data-controller="memo-body-editor tsuzura-picker" data-memo-body-editor-label-id-value="memo-body-label" data-memo-body-editor-wiki-completions-url-value=wiki_completions_memos_path(format: :json) data-memo-body-editor-wiki-link-labels-url-value=wiki_link_labels_memos_path(format: :json) data-memo-body-editor-tsuzura-authorize-url-value=(memo.persisted? ? internal_tsuzura_sign_urls_path : "") data-memo-body-editor-memo-id-value=(memo.persisted? ? memo.id : "") data-memo-body-editor-upload-url-value=(memo.image_assets_uploadable? ? assets_memo_path(memo) : "") data-tsuzura-picker-albums-url-value=internal_tsuzura_albums_path data-tsuzura-picker-album-url-template-value=internal_tsuzura_album_path("__ID__") data-tsuzura-picker-sign-urls-url-value=(memo.persisted? ? internal_tsuzura_sign_urls_path : "") data-tsuzura-picker-memo-id-value=(memo.persisted? ? memo.id : "") data-tsuzura-picker-manage-url-value=tsuzura_manage_url data-tsuzura-picker-editor-selector-value=".memo-body-editor"
        - wysiwyg_available = false # Temporarily hidden until block editing is stable.
        div.memo-body-editor__header.mb-1.border-b.kb-border.pb-2 data-controller=(memo.image_assets_uploadable? ? "memo-attachments" : nil) data-memo-attachments-expanded-value=(memo.image_assets_uploadable? ? "false" : nil)
          div.memo-body-editor__header-row
            nav.memo-body-editor__mode-tabs role="tablist" aria-label="編集モード" data-action="keydown->memo-body-editor#editModeTabKeydown"
              - if wysiwyg_available
                button#memo_body_editor_tab_wysiwyg.memo-body-editor__mode-tab type="button" role="tab" data-edit-mode="wysiwyg" data-memo-body-editor-target="editModeTab" data-action="memo-body-editor#setEditMode" aria-controls="memo_body_editor_panel_wysiwyg" aria-selected="false" tabindex="-1"
                  | WYSIWYG
              button#memo_body_editor_tab_source.memo-body-editor__mode-tab.is-active type="button" role="tab" data-edit-mode="source" data-memo-body-editor-target="editModeTab" data-action="memo-body-editor#setEditMode" aria-controls="memo_body_editor_panel_source" aria-selected="true" tabindex="0"
                | ソース
              div.memo-body-editor__asset-toolbar
                label.memo-body-editor__preview-toggle.memo-body-editor__source-only.inline-flex.cursor-pointer.items-center.gap-1.5 class=kb_toolbar_btn title="Asciidoctor.js によるライブプレビューを表示"
                  input type="checkbox" data-memo-body-editor-target="previewToggle" data-action="change->memo-body-editor#toggleLivePreview"
                  span ライブプレビュー
                button.inline-flex.items-center class=kb_toolbar_btn type="button" data-action="tsuzura-picker#open" title="Tsuzura アルバム・写真を本文に挿入"
                  | Tsuzura
                - if memo.image_assets_uploadable?
                  = link_to "ダイアグラムを作成", new_memo_diagram_path(memo), class: kb_toolbar_btn, target: "_blank", rel: "noopener"
                  label.cursor-pointer class=kb_toolbar_btn
                    | 画像を挿入
                    input.sr-only type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml" multiple=true data-memo-body-editor-target="imageInput" data-action="change->memo-body-editor#uploadImage"
                  label.cursor-pointer class=kb_toolbar_btn
                    | ファイルを添付
                    input.sr-only type="file" accept="application/pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.odt,.ods,.odp" multiple=true data-memo-body-editor-target="attachmentInput" data-action="change->memo-body-editor#uploadAttachment"
                  button.inline-flex.items-center class=kb_toolbar_btn type="button" data-action="memo-attachments#toggle" aria-expanded="false" aria-controls="memo-attachment-panel" title="添付ファイル一覧を開く"
                    | 添付ファイル
                    span.ml-0.5.leading-none data-memo-attachments-target="toggleIcon" aria-hidden="true"
                      | ▼
                - else
                  button.memo-body-editor__source-only.kb-toolbar-btn.is-disabled type="button" disabled=true title="メモを Git にコミットしてから画像を挿入できます"
                    | 画像を挿入
                  button.memo-body-editor__source-only.kb-toolbar-btn.is-disabled type="button" disabled=true title="メモを Git にコミットしてからファイルを添付できます"
                    | ファイルを添付
                span.hidden.text-xs.kb-status-danger data-memo-body-editor-target="uploadError"
            - if memo.image_assets_uploadable?
              = render "memos/attachment_panel", memo: memo, body: memo.body
          div#memo_body_editor_panel_source.memo-body-editor__source-pane role="tabpanel" aria-labelledby="memo_body_editor_tab_source" data-memo-body-editor-target="sourcePane"
            div.memo-body-editor__workspace
              div.memo-body-editor__source
                div.memo-body-editor__host.relative[data-memo-body-editor-target="host"]
              div.memo-body-editor__preview aria-hidden="true"
                div.memo-body-editor__preview-toolbar
                  span.memo-body-editor__preview-label Preview
                  label.memo-body-editor__preview-skin
                    span テーマ
                    select.kb-input.kb-input-xs aria-label="Preview theme" data-theme-select="true" data-memo-body-editor-target="previewSkinSelect"
                div.memo-body-editor__preview-content.memo-body.asciidoctor data-theme-slot="memo-body" data-memo-body-editor-target="previewHost"
          - if wysiwyg_available
            div#memo_body_editor_panel_wysiwyg.memo-body-editor__wysiwyg-pane role="tabpanel" aria-labelledby="memo_body_editor_tab_wysiwyg" data-memo-body-editor-target="wysiwygPane" hidden=true aria-hidden="true"
              div.memo-body-editor__wysiwyg-content.memo-body.asciidoctor contenteditable="false" spellcheck="false" data-theme-slot="memo-body" data-memo-body-editor-target="wysiwygHost"
          = f.text_area :body,
            rows: 1,
            class: "sr-only",
            tabindex: -1,
            autocomplete: "off",
            data: { memo_draft_target: "body", memo_body_editor_target: "field", action: "input->memo-draft#bodyInput compositionend->memo-draft#bodyInput blur->memo-draft#bodyInput" }
          = render "memos/tsuzura_picker"

    - if memo.persisted?
      = render "memos/show_backlinks", memo: memo

  - form_actions_hidden = !memo.persisted?
  div data-memo-draft-target="formActionsChrome" class=("hidden" if form_actions_hidden)
    = render "memos/form_actions", memo: memo, memo_edit_form_id: memo_edit_form_id

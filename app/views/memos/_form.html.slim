ruby:
  form_data = {
    controller: "memo-draft",
    action: "submit->memo-draft#preventSubmit keydown->memo-draft#suppressEnterSubmit",
    turbo: "false"
  }
  form_data[:memo_draft_draft_url_value] = draft_memo_path(memo) if memo.persisted?
  form_data[:memo_draft_create_url_value] = memos_path unless memo.persisted?
  form_data[:memo_draft_file_committed_value] = memo.file_committed_at.present?
  form_data[:memo_draft_memo_id_value] = memo.id if memo.persisted?

= form_with model: memo, class: "space-y-3", data: form_data do |f|
  = hidden_field_tag "memo[title_manual]", memo.title_manual ? "1" : "0", data: { memo_draft_target: "titleManualFlag" }
  - if memo.errors.any?
    .rounded-md.border.border-red-200.bg-red-50.px-4.py-3.text-sm.text-red-900
      p.font-medium 保存できませんでした。
      ul.mt-2.list-inside.list-disc.space-y-1
        - memo.errors.full_messages.each do |message|
          li = message

  - if memo.persisted?
    .hidden.rounded-md.border.border-amber-200.bg-amber-50.px-3.py-2.text-sm.text-amber-950 role="status" data-memo-draft-target="remoteNotice"
      span data-memo-draft-target="remoteNoticeText"
        | 別のタブでこのメモが保存されました。
      button.ml-2.rounded.border.border-amber-300.bg-white.px-2.py-0.5.text-xs.font-medium.hover:bg-amber-100 type="button" data-action="memo-draft#applyRemoteDraft"
        | 最新の本文を読み込む

  - if memo.persisted? && memo.account
    .mb-3.flex.items-center.gap-2.border-b.border-zinc-100.pb-3
      = gravatar_image_tag(memo.account, size: 28, extra_class: "shrink-0")
      div.min-w-0
        p.text-xs.text-zinc-500 作成者
        p.truncate.text-sm.font-medium.text-zinc-800 = memo.account.display_name

  div
    = render "title_field", memo: memo

  div
    = render "slug_field", memo: memo

  - if memo.persisted?
    div
      = render "directory_field", memo: memo
  - else
    div
      - selected_dir = memo.memo_directory&.root? ? nil : memo.memo_directory
      = render "shared/directory_tree_picker",
        label_text: "ディレクトリ",
        form_builder: f,
        field_method: :memo_directory_id,
        selected_directory: selected_dir,
        directory_options: memo_directories_for_select,
        placeholder_text: "保存先フォルダを選んでください",
        hidden_field_data: { memo_draft_target: "directory", action: "change->memo-draft#directoryChange" }

  div
    = render "visibility_field", memo: memo, f: f

  .flex.items-start.gap-3
    = label_tag "memo_properties_yaml", "プロパティ", class: "pt-1 text-sm font-medium text-zinc-800 whitespace-nowrap"
    .min-w-0.flex-1
      = text_area_tag "memo[properties_yaml]", memo_properties_yaml_value(memo), rows: 4, placeholder: "priority: 1\nlabels:\n  - ideas", class: memo_form_underline_properties_textarea(memo), data: { memo_draft_target: "propertiesYaml", action: "input->memo-draft#propertiesInput compositionend->memo-draft#propertiesInput" }
      - if memo.errors[:properties_yaml].any?
        p.mt-1.text-sm.text-red-700 = memo.errors[:properties_yaml].first

  = render "tag_field", memo: memo

  div
    = f.label :body, "本文（AsciiDoc）", id: "memo-body-label", class: "mb-1 block text-sm font-medium text-zinc-800"
    p.mb-1.text-xs.text-zinc-500
      | メモへの Wiki リンク:
      code class="text-zinc-600"
        | [[相手メモのタイトル]]
      | 、
      code class="text-zinc-600"
        | [[タイトル|表示名]]
      | 、
      code class="text-zinc-600"
        | [[slug-123]]
      | （スラッグはメモ ID 付きで全体一意。ディレクトリを移してもリンクは有効。
      | 旧形式の
      code class="text-zinc-600"
        | [[slug]]
      | や
      code class="text-zinc-600"
        | [[home/u-1/work/slug-123]]
      | も解決できる場合があります）
    div.memo-body-editor[
      class="block w-full border-0 rounded-none bg-transparent border-b border-zinc-300 min-h-[18rem]"
      data-controller="memo-body-editor"
      data-memo-body-editor-label-id-value="memo-body-label"
      data-memo-body-editor-wiki-completions-url-value=wiki_completions_memos_path(format: :json)
      data-memo-body-editor-wiki-link-labels-url-value=wiki_link_labels_memos_path(format: :json)
      data-memo-body-editor-memo-id-value=(memo.persisted? ? memo.id : "")
      data-memo-body-editor-upload-url-value=(memo.image_assets_uploadable? ? assets_memo_path(memo) : "")
    ]
      .mb-1.flex.flex-wrap.items-center.gap-2.border-b.border-zinc-100.pb-2
        button.rounded-md.border.border-zinc-300.bg-white.px-2.py-1.text-xs.font-medium.text-zinc-700.hover:bg-zinc-50 type="button" data-memo-body-editor-target="wysiwygToggle" data-action="memo-body-editor#toggleWysiwyg" aria-pressed="true" title="マーカーを表示する（WYSIWYG オフ）"
          | ソース表示
        - if memo.image_assets_uploadable?
          = link_to "ダイアグラムを作成", new_memo_diagram_path(memo), class: "rounded-md border border-zinc-300 bg-white px-2 py-1 text-xs font-medium text-zinc-700 hover:bg-zinc-50", target: "_blank", rel: "noopener"
          = render "memos/diagram_links", memo: memo, compact: true
          label.cursor-pointer.rounded-md.border.border-zinc-300.bg-white.px-2.py-1.text-xs.font-medium.text-zinc-700.hover:bg-zinc-50
            | 画像を挿入
            input.sr-only type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml" multiple=true data-memo-body-editor-target="imageInput" data-action="change->memo-body-editor#uploadImage"
        - else
          button.rounded-md.border.border-zinc-200.bg-zinc-100.px-2.py-1.text-xs.font-medium.text-zinc-400.cursor-not-allowed type="button" disabled=true title="メモを Git にコミットしてから画像を挿入できます"
            | 画像を挿入
        span.hidden.text-xs.text-red-600 data-memo-body-editor-target="uploadError"
        p.text-xs.text-zinc-500
          - if memo.image_assets_uploadable?
            | 画像は
            code.text-zinc-600 image::filename[]
            | 形式で保存されます（コミット時に Git へ記録）。エディタへドラッグ＆ドロップ、または画像の貼り付け（Ctrl+V）でも挿入できます。数式は
            code.text-zinc-600 stem:[E=mc^2]
            |  /
            code.text-zinc-600 latexmath:[\\int x dx]
            | 等（表示時に KaTeX でレンダリング）。
          - else
            | 画像の挿入はメモを Git にコミットした後に利用できます（新規作成時・未コミットのドラフトでは利用できません）。
      = f.text_area :body,
        rows: 1,
        class: "sr-only",
        tabindex: -1,
        autocomplete: "off",
        data: { memo_draft_target: "body", memo_body_editor_target: "field", action: "input->memo-draft#bodyInput compositionend->memo-draft#bodyInput blur->memo-draft#bodyInput" }
      div.memo-body-editor__host.relative[data-memo-body-editor-target="host" style="min-height: inherit"]

  - if memo.persisted?
    .mt-4.flex.justify-end.gap-2
      = link_to (memo.display_as_draft? ? "プレビュー" : "表示"), memo_path(memo), class: "rounded-md border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-800 hover:bg-zinc-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:ring-offset-2"
      = f.submit "コミット", title: "ファイルへ保存して、Gitに記録", data: { memo_commit: true }, class: "rounded-md bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:ring-offset-2"


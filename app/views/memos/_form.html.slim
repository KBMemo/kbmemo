ruby:
  form_data = {
    controller: "memo-draft",
    action: "submit->memo-draft#preventSubmit",
    turbo: "false"
  }
  form_data[:memo_draft_draft_url_value] = draft_memo_path(memo) if memo.persisted?
  form_data[:memo_draft_create_url_value] = memos_path unless memo.persisted?

= form_with model: memo, class: "space-y-6", data: form_data do |f|
  = hidden_field_tag "memo[title_manual]", memo.title_manual ? "1" : "0", data: { memo_draft_target: "titleManualFlag" }
  - if memo.errors.any?
    .rounded-md.border.border-red-200.bg-red-50.px-4.py-3.text-sm.text-red-900
      p.font-medium 保存できませんでした。
      ul.mt-2.list-inside.list-disc.space-y-1
        - memo.errors.full_messages.each do |message|
          li = message

  div
    = render "title_field", memo: memo

  div
    = f.label :slug, "スラッグ（任意・将来URL用）", class: "block text-sm font-medium text-zinc-800"
    = f.text_field :slug, autocomplete: "off", placeholder: "例: weekly-notes", class: "mt-1 block w-full rounded-md border border-zinc-300 px-3 py-2 font-mono text-sm text-zinc-900 shadow-sm placeholder:text-zinc-400 focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900", data: { memo_draft_target: "slug", action: "input->memo-draft#slugInput compositionend->memo-draft#slugInput" }

  div
    = f.label :body, "本文（AsciiDoc）", class: "block text-sm font-medium text-zinc-800"
    = f.text_area :body, rows: 18, class: "mt-1 block w-full rounded-md border border-zinc-300 px-3 py-2 font-mono text-sm leading-relaxed text-zinc-900 shadow-sm placeholder:text-zinc-400 focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900", data: { memo_draft_target: "body", action: "input->memo-draft#bodyInput compositionend->memo-draft#bodyInput blur->memo-draft#bodyInput" }

  div
    = label_tag "memo_tag_list", "タグ（カンマ区切り）", class: "block text-sm font-medium text-zinc-800"
    = text_field_tag "memo[tag_list]", memo.tags.map(&:name).join(", "), autocomplete: "off", placeholder: "ideas, work", class: "mt-1 block w-full rounded-md border border-zinc-300 px-3 py-2 text-zinc-900 shadow-sm placeholder:text-zinc-400 focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900", data: { memo_draft_target: "tagList", action: "input->memo-draft#tagListInput compositionend->memo-draft#tagListInput" }

  div
    = label_tag "memo_properties_json", "プロパティ（JSON オブジェクト）", class: "block text-sm font-medium text-zinc-800"
    - props_classes = "mt-1 block w-full rounded-md border px-3 py-2 font-mono text-sm leading-relaxed shadow-sm focus:outline-none focus:ring-1 "
    - props_classes += memo.errors[:properties_json].any? ? "border-red-500 text-red-900 focus:border-red-600 focus:ring-red-600" : "border-zinc-300 text-zinc-900 focus:border-zinc-900 focus:ring-zinc-900"
    = text_area_tag "memo[properties_json]", memo_properties_json_value(memo), rows: 8, class: props_classes, data: { memo_draft_target: "propertiesJson", action: "input->memo-draft#propertiesInput compositionend->memo-draft#propertiesInput" }
    - if memo.errors[:properties_json].any?
      p.mt-1.text-sm.text-red-700 = memo.errors[:properties_json].first

  .mt-8.border-t.border-zinc-200.pt-6
    = link_to "一覧へ", memos_path, class: "text-sm text-zinc-600 hover:text-zinc-900"

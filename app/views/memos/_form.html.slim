ruby:
  form_data = {
    controller: "memo-draft",
    action: "submit->memo-draft#preventSubmit keydown->memo-draft#suppressEnterSubmit",
    turbo: "false"
  }
  form_data[:memo_draft_draft_url_value] = draft_memo_path(memo) if memo.persisted?
  form_data[:memo_draft_create_url_value] = memos_path unless memo.persisted?
  form_data[:memo_draft_file_committed_value] = memo.file_committed_at.present?

= form_with model: memo, class: "space-y-3", data: form_data do |f|
  = hidden_field_tag "memo[title_manual]", memo.title_manual ? "1" : "0", data: { memo_draft_target: "titleManualFlag" }
  - if memo.errors.any?
    .rounded-md.border.border-red-200.bg-red-50.px-4.py-3.text-sm.text-red-900
      p.font-medium 保存できませんでした。
      ul.mt-2.list-inside.list-disc.space-y-1
        - memo.errors.full_messages.each do |message|
          li = message

  - if memo.persisted? && memo.account
    .mb-3.flex.items-center.gap-2.border-b.border-zinc-100.pb-3
      = gravatar_image_tag(memo.account, size: 28, extra_class: "shrink-0")
      div.min-w-0
        p.text-xs.text-zinc-500 作成者
        p.truncate.text-sm.font-medium.text-zinc-800 = memo.account.display_name

  div
    = render "title_field", memo: memo

  div
    = render "slug_field", memo: memo

  - if memo.persisted?
    div
      = render "directory_field", memo: memo
  - else
    div
      - selected_dir = memo.memo_directory&.root? ? nil : memo.memo_directory
      = render "shared/directory_tree_picker",
        label_text: "ディレクトリ",
        form_builder: f,
        field_method: :memo_directory_id,
        selected_directory: selected_dir,
        directory_options: memo_directories_for_select,
        placeholder_text: "保存先フォルダを選んでください",
        hidden_field_data: {}

  div
    = render "visibility_field", memo: memo, f: f

  .flex.items-start.gap-3
    = label_tag "memo_properties_yaml", "プロパティ", class: "pt-1 text-sm font-medium text-zinc-800 whitespace-nowrap"
    .min-w-0.flex-1
      = text_area_tag "memo[properties_yaml]", memo_properties_yaml_value(memo), rows: 4, placeholder: "priority: 1\nlabels:\n  - ideas", class: memo_form_underline_properties_textarea(memo), data: { memo_draft_target: "propertiesYaml", action: "input->memo-draft#propertiesInput compositionend->memo-draft#propertiesInput" }
      - if memo.errors[:properties_yaml].any?
        p.mt-1.text-sm.text-red-700 = memo.errors[:properties_yaml].first

  = render "tag_field", memo: memo

  div
    = f.label :body, "本文（AsciiDoc）", class: "mb-1 block text-sm font-medium text-zinc-800"
    = f.text_area :body, rows: 14, class: memo_form_underline_body, data: { memo_draft_target: "body", action: "input->memo-draft#bodyInput compositionend->memo-draft#bodyInput blur->memo-draft#bodyInput" }

  - if memo.persisted?
    .mt-4.flex.justify-end.gap-2
      = link_to (memo.display_as_draft? ? "プレビュー" : "表示"), memo_path(memo), class: "rounded-md border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-800 hover:bg-zinc-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:ring-offset-2"
      = f.submit "コミット", title: "ファイルへ保存して、Gitに記録", data: { memo_commit: true }, class: "rounded-md bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:ring-offset-2"


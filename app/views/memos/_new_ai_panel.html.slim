.memo-ai-panel.kb-ai-panel.flex.h-full.min-h-0.flex-col.overflow-hidden data-theme-slot="memo-sidebar" aria-label="メモアシスト"
  .kb-memo-ai-header
    h2.text-sm.font-semibold.kb-text-primary メモアシスト
    = label_tag "new_memo_ai_model_role", "使用モデル", class: "sr-only"
    = select_tag "new_memo_ai_model_role",
      options_for_select(memo_ai_model_options(rodauth.rails_account), "main"),
      class: "kb-input kb-input-xs kb-memo-ai-model-select",
      disabled: true,
      aria: { label: "使用モデル" }
  .flex.min-h-0.flex-1.flex-col.gap-2.overflow-hidden.px-3.py-2
    p.shrink-0.text-xs.kb-text-muted メモを作成すると利用できます。
    .kb-ai-messages.hidden.min-h-0.flex-1.rounded-md.p-2
    label.sr-only for="new_memo_ai_prompt" AI への指示
    textarea#new_memo_ai_prompt.kb-input.kb-input-xs.w-full.shrink-0.resize-none.font-sans.leading-relaxed rows=3 disabled=true
    .flex.shrink-0.flex-wrap.gap-2
      button.kb-chrome-btn-primary.kb-btn-xs type="button" disabled=true 送信
      button.kb-chrome-btn-secondary.kb-btn-xs type="button" disabled=true 応答を挿入
      button.kb-toolbar-btn type="button" disabled=true 履歴を消去

- content_for :title, "編集 · #{@memo.title}"

- content_for :memos_editor do
  .mb-4.flex.flex-wrap.items-center.justify-between.gap-3
    h1.min-w-0.flex-1.text-xl.font-semibold.text-zinc-900 メモを編集
    = link_to "プレビュー", memo_path(@memo), class: "flex-shrink-0 rounded-md border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-800 hover:bg-zinc-50"
  = render "form", memo: @memo

div id=dom_id(memo)
  .mb-6.flex.flex-wrap.items-start.justify-between.gap-4
    div.min-w-0.flex-1
      h1.text-2xl.font-semibold.tracking-tight.text-zinc-900.break-words = memo.title
      .mt-3.flex.flex-wrap.items-center.gap-x-3.gap-y-2
        = gravatar_image_tag(memo.account, size: 36, extra_class: "shrink-0")
        .flex.min-w-0.flex-1.flex-col.gap-1
          p.text-sm.font-medium.text-zinc-800
            span.sr-only 作成者
            = memo.account.display_name
          .flex.flex-wrap.items-center.gap-x-3.gap-y-1.text-sm.text-zinc-500
            time datetime=memo.updated_at.iso8601
              | 更新 #{memo.updated_at.strftime("%Y-%m-%d %H:%M")}
            - dir = memo.memo_directory
            - if dir && !dir.root?
              span.text-zinc-400 aria-hidden="true" ·
              = link_to memo_directory_path_from_root_label(dir),
                memo_path(memo, memo_directory_id: dir.id),
                class: "underline decoration-zinc-300 hover:text-zinc-800",
                title: "サイドバーでこのディレクトリを表示"
            - if memo.slug.present?
              span.text-zinc-400 aria-hidden="true" ·
              span.font-mono.text-xs.text-zinc-600 = memo.slug
    .flex.flex-shrink-0.flex-wrap.items-center.gap-2
      = link_to "編集", edit_memo_path(memo), class: "rounded-md bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-zinc-800"
      = button_to "削除", memo_path(memo), method: :delete, form: { data: { turbo_confirm: "このメモを削除しますか？" } }, class: "rounded-md border border-red-200 bg-white px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50"

  - if memo.tags.any?
    ul.mb-6.flex.flex-wrap.gap-2
      - memo.tags.each do |tag|
        li
          = link_to tag.name,
            memo_sidebar_open_memo_path(memo, sidebar_view: "tag", tag_id: tag.id),
            class: "inline-block rounded-full bg-white px-3 py-1 text-sm text-zinc-700 ring-1 ring-zinc-200 underline decoration-zinc-300 hover:bg-zinc-50 hover:text-zinc-900",
            title: "サイドバーでこのタグを表示"

  - if memo.properties.present?
    section.mb-8.rounded-lg.border.border-zinc-200.bg-white.p-4.shadow-sm
      h2.mb-2.text-sm.font-semibold.text-zinc-800 プロパティ
      pre.overflow-x-auto.rounded-md.bg-zinc-50.p-3.font-mono.text-xs.text-zinc-800 = memo_properties_yaml_value(memo)

  article.memo-body.rounded-lg.border.border-zinc-200.bg-white.p-6.shadow-sm
    .max-w-none.text-zinc-800 class="[&_a]:text-blue-600 [&_a]:underline [&_code]:rounded [&_code]:bg-zinc-100 [&_code]:px-1 [&_h1]:mb-4 [&_h1]:text-2xl [&_h1]:font-semibold [&_h2]:mb-3 [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-semibold [&_li]:my-1 [&_pre]:overflow-x-auto [&_pre]:rounded-md [&_pre]:bg-zinc-900 [&_pre]:p-4 [&_pre]:text-sm [&_pre]:text-zinc-100"
      == memo_html(memo.body, source_memo: memo)

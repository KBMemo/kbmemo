ruby:
  metadata_editable = policy(memo).update?

= tag.div(**memo_show_content_tag_options(memo)) do
  .mb-6.flex.flex-wrap.items-start.justify-between.gap-4
    div.min-w-0.flex-1
      h1.text-2xl.font-semibold.tracking-tight.break-words data-theme-slot="memo-title" = memo.title
      .mt-3.flex.flex-wrap.items-center.gap-x-3.gap-y-2
        = gravatar_image_tag(memo.account, size: 36, extra_class: "shrink-0", loading: "eager", fetchpriority: "low")
        .flex.min-w-0.flex-1.flex-col.gap-1
          p.text-sm.font-medium.kb-text-primary
            span.sr-only 作成者
            = memo.account.display_name
          .flex.flex-wrap.items-center.gap-x-3.gap-y-1.text-sm.kb-text-muted
            time datetime=memo.updated_at.iso8601
              | 更新 #{memo.updated_at.strftime("%Y-%m-%d %H:%M")}
            - if memo.board.present? && policy(memo.board).show?
              span.kb-text-subtle aria-hidden="true" ·
              span.inline-flex.min-w-0.items-center.gap-1
                i class="h-3.5 w-3.5 shrink-0 kb-text-subtle" aria-hidden="true" data-lucide="kanban"
                = link_to memo.board.title,
                  board_path(memo.board),
                  class: "min-w-0 truncate kb-inline-link",
                  title: "カンバンボードを開く"
            - if memo.notebook.present? && policy(memo.notebook).show?
              span.kb-text-subtle aria-hidden="true" ·
              span.inline-flex.min-w-0.items-center.gap-1
                i class="h-3.5 w-3.5 shrink-0 kb-text-subtle" aria-hidden="true" data-lucide="book-open"
                = link_to memo.notebook.title,
                  notebook_path(memo.notebook, memo_id: memo.id),
                  class: "min-w-0 truncate kb-inline-link",
                  title: "ノートブックを開く"
            - dir = memo.memo_directory
            - if metadata_editable
              span.kb-text-subtle aria-hidden="true" ·
              span.inline-block.min-w-0.max-w-full
                - selected_dir = dir&.root? ? nil : dir
                = render "shared/directory_tree_picker",
                  label_text: "ディレクトリ",
                  field_name: "memo_show_directory_id",
                  field_id: "memo_show_directory_id_#{memo.id}",
                  selected_directory: selected_dir,
                  directory_options: memo_directories_for_select,
                  placeholder_text: "保存先フォルダを選んでください",
                  hidden_field_data: { memo_show_metadata_target: "directoryInput", action: "change->memo-show-metadata#directoryChange" },
                  sidebar_open_path: memo_path(memo)
            - elsif dir && !dir.root?
              span.kb-text-subtle aria-hidden="true" ·
              = link_to memo_directory_path_from_root_label(dir),
                memo_path(memo, memo_directory_id: dir.id),
                class: "kb-inline-link",
                title: "サイドバーでこのディレクトリを表示"
            - if memo.slug.present?
              span.kb-text-subtle aria-hidden="true" ·
              span.font-mono.text-xs.kb-text-secondary = memo.slug
    .flex.flex-shrink-0.flex-wrap.items-center.gap-2
      - if memo.docs_sync_read_only?
        span.text-sm.kb-text-muted docs/ 同期
      - elsif memo.google_calendar_read_only?
        span.text-sm.kb-text-muted Google Calendar
      - elsif memo.display_as_draft? && policy(memo).update?
        = button_to "コミット", commit_memo_path(memo), method: :patch, title: "ファイルへ保存して、Gitに記録", class: "kb-chrome-btn-primary kb-btn-md", data: { theme_slot: "btn-primary" }
        = link_to "編集", edit_memo_path(memo), class: "kb-chrome-btn-secondary kb-btn-md"
      - elsif policy(memo).update?
        = link_to "編集", edit_memo_path(memo), class: "kb-chrome-btn-primary kb-btn-md", data: { theme_slot: "btn-primary" }
      - if policy(memo).destroy?
        = button_to "削除", memo_path(memo), method: :delete, form: { data: { turbo_confirm: "このメモを削除しますか？" } }, class: "kb-danger-btn kb-btn-sm"

  - if memo.docs_sync_read_only?
    .mb-4.kb-muted-bar.px-3.py-2.text-sm
      | このメモは Git リポジトリの
      code.font-mono.text-xs docs/
      |  から同期されています。変更は AsciiDoc を編集して
      code.font-mono.text-xs bin/rails kbmemo:docs:sync
      |  を実行してください。
      - if (source_path = memo.properties.dig("docs_sync", "source_path")).present?
        span.kb-text-muted.ml-1
          | （
          code.font-mono.text-xs = source_path
          | ）

  - if memo.google_calendar_read_only?
    .mb-4.kb-muted-bar.px-3.py-2.text-sm
      | このメモは Google Calendar から同期されています。KBMemo 上では閲覧のみです。変更は Google Calendar 側で行い、
      = link_to "プロフィール", edit_profile_path, class: "kb-chrome-link underline"
      |  から同期してください。
      - if memo.google_calendar_html_link.present?
        span.kb-text-muted.ml-1
          = link_to "Google Calendar で開く", memo.google_calendar_html_link, class: "kb-chrome-link underline", target: "_blank", rel: "noopener"

  = render "memos/show_tags", memo: memo, editable: metadata_editable

  - if memo.properties.present?
    section.mb-8.kb-card.p-4 data-controller="expandable-hint" data-expandable-hint-expanded-value="false" data-expandable-hint-expand-label-value="プロパティ全文を表示" data-expandable-hint-collapse-label-value="プロパティ全文を閉じる"
      .flex.min-w-0.items-center.gap-2
        h2.shrink-0.text-sm.font-semibold.kb-text-primary プロパティ
        p.min-w-0.flex-1.truncate.font-mono.text-xs.kb-text-secondary title=memo_properties_summary_line(memo)
          = memo_properties_summary_line(memo)
        button.shrink-0.inline-flex.h-6.w-6.items-center.justify-center.rounded.kb-toolbar-btn type="button" data-expandable-hint-target="toggleButton" data-action="expandable-hint#toggle" aria-expanded="false" aria-controls="memo-properties-panel" aria-label="プロパティ全文を表示" title="プロパティ全文を表示"
          span.leading-none data-expandable-hint-target="toggleIcon" aria-hidden="true"
            | ▼
      pre#memo-properties-panel.hidden.overflow-x-auto.kb-muted-bar.p-3.font-mono.text-xs.kb-text-primary data-expandable-hint-target="panel"
        = memo_properties_yaml_value(memo)

  - checklist_editable = memo_checklist_editable?(memo)
  = tag.article(**memo_body_tag_options(memo)) do
    - if checklist_editable
      .max-w-none data-controller="memo-checklist" data-memo-checklist-toggle-url-value=checklist_toggle_memo_path(memo) data-action="change->memo-checklist#toggle"
        == memo_html(memo.body, source_memo: memo)
    - else
      .max-w-none
        == memo_html(memo.body, source_memo: memo)

  = render "memos/show_backlinks", memo: memo

ruby:
  metadata_editable = policy(memo).update?

= tag.div(**memo_show_content_tag_options(memo)) do
  .mb-6.flex.flex-wrap.items-start.justify-between.gap-4
    div.min-w-0.flex-1
      h1.text-2xl.font-semibold.tracking-tight.break-words data-theme-slot="memo-title" = memo.title
      .mt-3.flex.flex-wrap.items-center.gap-x-3.gap-y-2
        = gravatar_image_tag(memo.account, size: 36, extra_class: "shrink-0")
        .flex.min-w-0.flex-1.flex-col.gap-1
          p.text-sm.font-medium.text-zinc-800
            span.sr-only 作成者
            = memo.account.display_name
          .flex.flex-wrap.items-center.gap-x-3.gap-y-1.text-sm.text-zinc-500
            time datetime=memo.updated_at.iso8601
              | 更新 #{memo.updated_at.strftime("%Y-%m-%d %H:%M")}
            - if memo.board.present? && policy(memo.board).show?
              span.text-zinc-400 aria-hidden="true" ·
              = link_to memo.board.title,
                board_path(memo.board),
                class: "underline decoration-zinc-300 hover:text-zinc-800",
                title: "カンバンボードを開く"
            - dir = memo.memo_directory
            - if metadata_editable
              span.text-zinc-400 aria-hidden="true" ·
              span.inline-block.min-w-0.max-w-full
                - selected_dir = dir&.root? ? nil : dir
                = render "shared/directory_tree_picker",
                  label_text: "ディレクトリ",
                  field_name: "memo_show_directory_id",
                  field_id: "memo_show_directory_id_#{memo.id}",
                  selected_directory: selected_dir,
                  directory_options: memo_directories_for_select,
                  placeholder_text: "保存先フォルダを選んでください",
                  hidden_field_data: { memo_show_metadata_target: "directoryInput", action: "change->memo-show-metadata#directoryChange" },
                  sidebar_open_path: memo_path(memo)
            - elsif dir && !dir.root?
              span.text-zinc-400 aria-hidden="true" ·
              = link_to memo_directory_path_from_root_label(dir),
                memo_path(memo, memo_directory_id: dir.id),
                class: "underline decoration-zinc-300 hover:text-zinc-800",
                title: "サイドバーでこのディレクトリを表示"
            - if memo.slug.present?
              span.text-zinc-400 aria-hidden="true" ·
              span.font-mono.text-xs.text-zinc-600 = memo.slug
    .flex.flex-shrink-0.flex-wrap.items-center.gap-2
      - if memo.display_as_draft? && policy(memo).update?
        = button_to "コミット", commit_memo_path(memo), method: :patch, title: "ファイルへ保存して、Gitに記録", class: "kb-chrome-btn-primary", data: { theme_slot: "btn-primary" }
        = link_to "編集", edit_memo_path(memo), class: "kb-chrome-btn-secondary"
      - else
        = link_to "編集", edit_memo_path(memo), class: "kb-chrome-btn-primary", data: { theme_slot: "btn-primary" }
      = button_to "削除", memo_path(memo), method: :delete, form: { data: { turbo_confirm: "このメモを削除しますか？" } }, class: "rounded-md border border-red-200 bg-white px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50"

  = render "memos/show_tags", memo: memo, editable: metadata_editable

  - if memo.properties.present?
    section.mb-8.rounded-lg.border.border-zinc-200.bg-white.p-4.shadow-sm data-controller="expandable-hint" data-expandable-hint-expanded-value="false" data-expandable-hint-expand-label-value="プロパティ全文を表示" data-expandable-hint-collapse-label-value="プロパティ全文を閉じる"
      .flex.min-w-0.items-center.gap-2
        h2.shrink-0.text-sm.font-semibold.text-zinc-800 プロパティ
        p.min-w-0.flex-1.truncate.font-mono.text-xs.text-zinc-600 title=memo_properties_summary_line(memo)
          = memo_properties_summary_line(memo)
        button.shrink-0.inline-flex.h-6.w-6.items-center.justify-center.rounded.border.border-zinc-300.bg-white.text-zinc-600.hover:bg-zinc-50 type="button" data-action="expandable-hint#toggle" aria-expanded="false" aria-controls="memo-properties-panel" title="プロパティ全文を表示"
          span.leading-none data-expandable-hint-target="toggleIcon" aria-hidden="true"
            | ▼
      pre#memo-properties-panel.hidden.overflow-x-auto.rounded-md.bg-zinc-50.p-3.font-mono.text-xs.text-zinc-800 data-expandable-hint-target="panel"
        = memo_properties_yaml_value(memo)

  - checklist_editable = policy(memo).update? && Array(memo.properties["checkboxes"]).any?
  article.memo-body.asciidoctor.kb-card.p-6 data-theme-slot="memo-body"
    - if checklist_editable
      .max-w-none data-controller="memo-checklist" data-memo-checklist-toggle-url-value=checklist_toggle_memo_path(memo) data-action="change->memo-checklist#toggle"
        == memo_html(memo.body, source_memo: memo)
    - else
      .max-w-none
        == memo_html(memo.body, source_memo: memo)

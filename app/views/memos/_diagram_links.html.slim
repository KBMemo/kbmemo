/ locals: (memo:, compact: false)
- compact = local_assigns.fetch(:compact, false)
- entries = memo_diagram_entries(memo)
- return unless entries.any?

- if compact
  .flex.flex-wrap.items-center.gap-x-2.gap-y-1.text-xs role="navigation" aria-label="既存のダイアグラム"
    span.text-zinc-500 既存:
    - entries.each do |entry|
      = link_to entry[:diagram_key],
        entry[:edit_url],
        class: "rounded border border-zinc-300 bg-white px-2 py-0.5 font-mono text-zinc-700 hover:bg-zinc-50",
        target: "_blank",
        rel: "noopener",
        title: entry[:asciidoc]
- else
  section.mb-6.rounded-lg.border.border-zinc-200.bg-white.p-4.shadow-sm
    h2.mb-2.text-sm.font-semibold.text-zinc-800
      | ダイアグラム
      span.ml-1.font-normal.text-zinc-500= "(#{entries.size})"
    ul.space-y-2
      - entries.each do |entry|
        li.flex.flex-wrap.items-center.justify-between.gap-2.rounded-md.border.border-zinc-100.bg-zinc-50.px-3.py-2
          .min-w-0
            code.text-sm.text-zinc-800= entry[:asciidoc]
            span.ml-2.text-xs.text-zinc-500= entry[:diagram_key]
            - unless entry[:svg_exists]
              span.ml-1.text-amber-700 title="SVG が未生成です。編集画面で保存してください"
                | （SVG なし）
          - if policy(memo).edit_diagram?
            = link_to "編集",
              entry[:edit_url],
              class: "shrink-0 rounded-md border border-zinc-300 bg-white px-3 py-1 text-sm font-medium text-zinc-800 hover:bg-zinc-50",
              target: "_blank",
              rel: "noopener"

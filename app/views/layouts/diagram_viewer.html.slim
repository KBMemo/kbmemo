doctype html
html lang="ja" data-kb-theme="default" data-kb-theme-base="default"
  head
    title
      = content_for(:title) || "ダイアグラム"
    meta[name="viewport" content="width=device-width,initial-scale=1"]
    = csrf_meta_tags
    = csp_meta_tag
    - if kb_theme_sync_enabled?
      meta name="kbmemo-theme-sync" content="true"
    = vite_client_tag
    = vite_javascript_tag "application"
    script#kbmemo-account-theme-json type="application/json"
      = raw json_escape(kb_account_theme_json)
  body.kb-chrome-body.min-h-screen
    = yield

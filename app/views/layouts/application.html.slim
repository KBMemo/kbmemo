doctype html
html lang="ja" data-kb-theme=kb_initial_theme_id data-kb-theme-base=kb_initial_theme_base data-kb-skin=kb_initial_skin_id
  head
    title
      = content_for(:title) || "Kbmemo"
    meta[name="viewport" content="width=device-width,initial-scale=1"]
    meta[name="color-scheme" content=kb_initial_color_scheme]
    meta[name="apple-mobile-web-app-capable" content="yes"]
    meta[name="application-name" content="Kbmemo"]
    meta[name="mobile-web-app-capable" content="yes"]
    = csrf_meta_tags
    = csp_meta_tag
    - if kb_theme_sync_enabled?
      meta name="kbmemo-theme-sync" content="true"
    = yield :head
    - # Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!)
    - #= tag.link rel: "manifest", href: pwa_manifest_path(format: :json)
    link[rel="icon" href="/icon.png" type="image/png"]
    link[rel="icon" href="/icon.svg" type="image/svg+xml"]
    link[rel="apple-touch-icon" href="/icon.png"]
    = vite_client_tag
    = vite_javascript_tag "application"
    script#kbmemo-account-theme-json type="application/json"
      = raw json_escape(kb_account_theme_json)
  body.kb-chrome-body.min-h-screen data-theme-slot="app-body" data-controller="flash-notice"
    a.kb-skip-link href="#main-content" 本文へスキップ
    header.kb-chrome-header data-theme-slot="app-header"
      nav.mx-auto.flex.w-full.flex-wrap.items-center.justify-between.gap-3.px-4.py-3 class=content_max_width_class
        = link_to root_path, class: "kb-chrome-brand" do
          = kbmemo_brand_icon
          span Kbmemo
        .flex.flex-wrap.items-center.gap-x-4.gap-y-2.text-sm
          = link_to "メモ", memos_path(sidebar_view: "history"), class: "kb-chrome-link"
          = render "layouts/nav_boards_menu"
          = render "layouts/nav_notebooks_menu"
          - if HelpNotebook.find
            = link_to "ヘルプ", help_path, class: "kb-chrome-link"
          = link_to "タグ管理", tags_path, class: "kb-chrome-link"
          = link_to "テーマ", theme_studio_path, class: "kb-chrome-link"
          - if rodauth.rails_account&.admin?
            = link_to "管理", admin_root_path, class: "kb-chrome-link"
          - if rodauth.rails_account
            .relative[data-controller="user-menu"]
              button.kb-header-menu-trigger.inline-flex.max-w-56.items-center.gap-1.text-left.font-medium[type="button" data-user-menu-target="button" data-action="user-menu#toggle" aria-expanded="false" aria-haspopup="true" title=(rodauth.rails_account.email)]
                span.min-w-0.flex-1.truncate.kb-text-primary
                  = rodauth.rails_account.display_name
                svg.h-4.w-4.flex-shrink-0.kb-text-muted[xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"]
                  path[stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"]
              .kb-menu-panel.absolute.right-0.top-full.z-50.mt-1.hidden.min-w-48.rounded-md.py-1.text-sm[data-user-menu-target="panel" role="menu"]
                = link_to "プロフィール", edit_profile_path, class: "kb-menu-item block px-3 py-2", role: "menuitem"
                = link_to "パスワード変更", rodauth.change_password_path, class: "kb-menu-item block px-3 py-2", role: "menuitem"
                .px-3.py-2 role="none"
                  label.flex.items-center.justify-between.gap-3.kb-text-primary
                    span.kb-text-secondary テーマ
                    select.kb-input.kb-input-xs data-theme-select="true" data-user-menu-target="themeSelect" data-action="change->user-menu#changeTheme" aria-label="表示テーマ"
                .px-3.py-2 role="none"
                  label.flex.items-center.justify-between.gap-3.kb-text-primary
                    span.kb-text-secondary 本文スキン
                    select.kb-input.kb-input-xs data-skin-select="true" data-user-menu-target="skinSelect" data-action="change->user-menu#changeSkin" aria-label="本文スキン"
                hr.my-1.border.kb-border
                = button_to "ログアウト", rodauth.logout_path, method: :post, form: { class: "block w-full" }, class: "kb-menu-item w-full rounded-none border-0 bg-transparent px-3 py-2 text-left text-sm font-normal", role: "menuitem"
          - if Rails.env.development?
            = link_to "送信メール", "/letter_opener", class: "kb-chrome-link kb-text-muted", target: "_blank", rel: "noopener"
    main#main-content.mx-auto.w-full.px-4 tabindex="-1" class=[content_max_width_class, (theme_studio_layout? ? "py-4" : (wide_content_layout? ? "py-6" : "py-8"))].join(" ")
      - if memos_wide_layout?
        div[class="hidden" aria-hidden="true"]
          = yield
        div class="kb-chrome-workspace kb-workspace-min flex -mx-4 flex-col border-t md:flex-row md:items-start" data-controller="memo-sidebar" data-memo-sidebar-storage-key-value="kbmemo_memo_sidebar_v1"
          #memo_sidebar_shell.kb-chrome-panel[class="kb-workspace-panel-max flex max-md:w-full flex-shrink-0 flex-col border-b kb-sidebar-width-transition duration-200 ease-out md:h-auto md:self-start md:flex-shrink-0 md:border-b-0 md:border-r md:border-t-0" data-theme-slot="memo-sidebar" data-memo-sidebar-target="shell"]
            button.kb-chrome-muted-bar.flex.w-full.shrink-0.items-center.justify-center.gap-2.border-b.px-2.py-2.text-left.text-xs.font-medium.md:hidden[type="button" data-memo-sidebar-target="toggleButtonMobile" data-action="memo-sidebar#toggle" aria-expanded="true" aria-controls="memos_list_panel"]
              span.text-sm.leading-none.tabular-nums[aria-hidden="true" data-memo-sidebar-target="toggleGlyphMobile"] ◀
              span.sr-only メモ一覧サイドバー
              span[data-memo-sidebar-target="toggleLabelMobile"] 折りたたむ
            .flex.flex-col[data-memo-sidebar-target="body"]
              = render "memos/list_panel"
          button class=kb_sidebar_toggle_btn type="button" data-memo-sidebar-target="toggleButton" data-action="memo-sidebar#toggle" aria-expanded="true" aria-controls="memos_list_panel" title="メモ一覧サイドバーを折りたたむ"
            span.select-none.tracking-tighter[aria-hidden="true" data-memo-sidebar-target="toggleGlyph"] ««
            span.sr-only メモ一覧サイドバー
          div class=kb_resizer role="separator" aria-orientation="vertical" aria-label="サイドバーの幅を変更" title="ドラッグまたは左右キーで幅を変更" tabindex="0" data-memo-sidebar-target="resizer" data-action="pointerdown->memo-sidebar#resizerPointerDown keydown->memo-sidebar#resizerKeydown"
          section[class="kb-workspace-min flex min-w-0 flex-1 flex-col"]
            div#memos_editor_scroll[class="flex-1 px-4 py-5 md:px-8"]
              = yield :memos_editor
          - if content_for?(:memo_ai_sidebar)
            div#memo_ai_sidebar_region class="kb-ai-sidebar-region flex min-h-0 shrink-0 max-md:w-full max-md:flex-col md:h-full md:flex-row md:items-stretch md:overflow-hidden" data-controller="memo-ai-sidebar" data-memo-ai-sidebar-storage-key-value="kbmemo_memo_ai_sidebar_v1"
              button class=kb_sidebar_toggle_btn type="button" data-memo-ai-sidebar-target="toggleButton" data-action="memo-ai-sidebar#toggle" aria-expanded="true" aria-controls="memo_ai_sidebar_panel" title="AI パネルを折りたたむ"
                span.select-none.tracking-tighter[aria-hidden="true" data-memo-ai-sidebar-target="toggleGlyph"] »»
                span.sr-only AI パネル
              div class=kb_resizer role="separator" aria-orientation="vertical" aria-label="AI パネルの幅を変更" title="ドラッグまたは左右キーで幅を変更" tabindex="0" data-memo-ai-sidebar-target="resizer" data-action="pointerdown->memo-ai-sidebar#resizerPointerDown keydown->memo-ai-sidebar#resizerKeydown"
              #memo_ai_sidebar_shell.kb-chrome-panel[class="flex max-md:w-full min-h-0 flex-shrink-0 flex-col overflow-hidden border-t kb-sidebar-size-transition duration-200 ease-out md:max-h-full md:h-full md:border-t-0 md:border-l md:border-b-0" data-theme-slot="memo-sidebar" data-memo-ai-sidebar-target="shell"]
                button.kb-chrome-muted-bar.flex.w-full.shrink-0.items-center.justify-center.gap-2.border-b.px-2.py-2.text-left.text-xs.font-medium.md:hidden[type="button" data-memo-ai-sidebar-target="toggleButtonMobile" data-action="memo-ai-sidebar#toggle" aria-expanded="true" aria-controls="memo_ai_sidebar_panel"]
                  span.text-sm.leading-none.tabular-nums[aria-hidden="true" data-memo-ai-sidebar-target="toggleGlyphMobile"] »»
                  span.sr-only AI パネル
                  span[data-memo-ai-sidebar-target="toggleLabelMobile"] 折りたたむ
                .flex.min-h-0.flex-1.flex-col.overflow-hidden#memo_ai_sidebar_panel[data-memo-ai-sidebar-target="body"]
                  = yield :memo_ai_sidebar
      - elsif notebook_show_wide_layout?
        div[class="hidden" aria-hidden="true"]
          = yield
        div class="kb-chrome-workspace kb-workspace-min flex -mx-4 flex-col border-t md:flex-row md:items-start" data-controller="memo-sidebar notebook-memo-tree" data-memo-sidebar-storage-key-value="kbmemo_notebook_sidebar_v1" data-notebook-memo-tree-reorder-url-value=reorder_memos_notebook_path(@notebook)
          #notebook_sidebar_shell.kb-chrome-panel[class="kb-workspace-panel-max flex max-md:w-full flex-shrink-0 flex-col border-b kb-sidebar-width-transition duration-200 ease-out md:h-auto md:self-start md:flex-shrink-0 md:border-b-0 md:border-r md:border-t-0" data-theme-slot="memo-sidebar" data-memo-sidebar-target="shell"]
            button.kb-chrome-muted-bar.flex.w-full.shrink-0.items-center.justify-center.gap-2.border-b.px-2.py-2.text-left.text-xs.font-medium.md:hidden[type="button" data-memo-sidebar-target="toggleButtonMobile" data-action="memo-sidebar#toggle" aria-expanded="true" aria-controls="notebook_memo_tree"]
              span.text-sm.leading-none.tabular-nums[aria-hidden="true" data-memo-sidebar-target="toggleGlyphMobile"] ◀
              span.sr-only ノートブックメモ一覧
              span[data-memo-sidebar-target="toggleLabelMobile"] 折りたたむ
            .flex.flex-col[data-memo-sidebar-target="body"]
              = render "notebooks/sidebar_panel"
          button class=kb_sidebar_toggle_btn type="button" data-memo-sidebar-target="toggleButton" data-action="memo-sidebar#toggle" aria-expanded="true" aria-controls="notebook_memo_tree" title="メモ一覧サイドバーを折りたたむ"
            span.select-none.tracking-tighter[aria-hidden="true" data-memo-sidebar-target="toggleGlyph"] ««
            span.sr-only ノートブックメモ一覧
          div class=kb_resizer role="separator" aria-orientation="vertical" aria-label="サイドバーの幅を変更" title="ドラッグまたは左右キーで幅を変更" tabindex="0" data-memo-sidebar-target="resizer" data-action="pointerdown->memo-sidebar#resizerPointerDown keydown->memo-sidebar#resizerKeydown"
          section[class="kb-workspace-min flex min-w-0 flex-1 flex-col"]
            div#notebook_memo_panel[class="flex-1 px-4 py-5 md:px-8"]
              = yield :notebook_memo_panel
      - else
        = yield
    = render "shared/flash_toasts"

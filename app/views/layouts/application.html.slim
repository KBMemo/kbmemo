doctype html
html
  head
    title
      = content_for(:title) || "Kbmemo"
    meta[name="viewport" content="width=device-width,initial-scale=1"]
    meta[name="apple-mobile-web-app-capable" content="yes"]
    meta[name="application-name" content="Kbmemo"]
    meta[name="mobile-web-app-capable" content="yes"]
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    - # Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!)
    - #= tag.link rel: "manifest", href: pwa_manifest_path(format: :json)
    link[rel="icon" href="/icon.png" type="image/png"]
    link[rel="icon" href="/icon.svg" type="image/svg+xml"]
    link[rel="apple-touch-icon" href="/icon.png"]
    = vite_client_tag
    = vite_javascript_tag "application"
  body.min-h-screen.bg-zinc-50.text-zinc-900.antialiased
    header.border-b.border-zinc-200.bg-white
      nav.mx-auto.flex.w-full.flex-wrap.items-center.justify-between.gap-3.px-4.py-3 class=(memos_wide_layout? ? "max-w-[1800px]" : "max-w-3xl")
        = link_to root_path, class: "text-lg font-semibold tracking-tight text-zinc-900" do
          | Kbmemo
        .flex.flex-wrap.items-center.gap-x-4.gap-y-2.text-sm
          = link_to "メモ", memos_path, class: "text-zinc-600 hover:text-zinc-900"
          = link_to "タグ管理", tags_path, class: "text-zinc-600 hover:text-zinc-900"
          - if rodauth.rails_account&.admin?
            = link_to "管理", admin_root_path, class: "text-zinc-600 hover:text-zinc-900"
          - if rodauth.rails_account
            .relative[data-controller="user-menu"]
              button.inline-flex.max-w-56.items-center.gap-1.rounded-md.border.border-zinc-300.bg-white.py-1.pl-2.pr-1.5.text-left.text-sm.font-medium.text-zinc-800.shadow-sm.hover:bg-zinc-50[type="button" data-user-menu-target="button" data-action="user-menu#toggle" aria-expanded="false" aria-haspopup="true" title=(rodauth.rails_account.email)]
                span.min-w-0.flex-1.truncate
                  = rodauth.rails_account.display_name
                svg.h-4.w-4.flex-shrink-0.text-zinc-500[xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"]
                  path[stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"]
              .absolute.right-0.top-full.z-50.mt-1.hidden.min-w-48.rounded-md.border.border-zinc-200.bg-white.py-1.text-sm.shadow-lg[data-user-menu-target="panel" role="menu"]
                = link_to "ニックネーム", edit_profile_path, class: "block px-3 py-2 text-zinc-800 hover:bg-zinc-50", role: "menuitem"
                = link_to "パスワード変更", rodauth.change_password_path, class: "block px-3 py-2 text-zinc-800 hover:bg-zinc-50", role: "menuitem"
                hr.my-1.border-zinc-200
                = button_to "ログアウト", rodauth.logout_path, method: :post, form: { class: "block w-full" }, class: "w-full rounded-none border-0 bg-transparent px-3 py-2 text-left text-sm font-normal text-zinc-800 hover:bg-zinc-50", role: "menuitem"
          - if Rails.env.development?
            = link_to "送信メール", "/letter_opener", class: "text-zinc-500 hover:text-zinc-800", target: "_blank", rel: "noopener"
          = link_to "新規メモ", new_memo_path_with_current_directory, class: "rounded-md bg-zinc-900 px-3 py-1.5 font-medium text-white hover:bg-zinc-800"
    main.mx-auto.w-full.px-4 class=(memos_wide_layout? ? "max-w-[1800px] py-6" : "max-w-3xl py-8")
      - flash.each do |level, message|
        - next if message.blank?
        - alert_classes = (level.to_sym == :notice) ? "border-emerald-200 bg-emerald-50 text-emerald-900" : "border-amber-200 bg-amber-50 text-amber-900"
        p.mb-4.rounded-md.border.px-3.py-2.text-sm class=alert_classes role="status"
          = message
      - if memos_wide_layout?
        div[class="hidden" aria-hidden="true"]
          = yield
        div[class="flex -mx-4 flex-col border-t border-zinc-200 bg-zinc-50 md:min-h-[calc(100vh-6.75rem)] md:flex-row md:items-stretch" data-controller="memo-sidebar" data-memo-sidebar-storage-key-value="kbmemo_memo_sidebar_v1"]
          #memo_sidebar_shell[class="flex max-h-[min(42vh,360px)] max-md:w-full min-h-0 flex-shrink-0 flex-col border-b border-zinc-200 bg-white transition-[width,max-height] duration-200 ease-out md:max-h-none md:h-full md:flex-shrink-0 md:border-b-0 md:border-r md:border-t-0" data-memo-sidebar-target="shell"]
            button.flex.w-full.shrink-0.items-center.justify-center.gap-2.border-b.border-zinc-200.bg-zinc-50.px-2.py-2.text-left.text-xs.font-medium.text-zinc-700.hover:bg-zinc-100.md:py-1.5[type="button" data-memo-sidebar-target="toggleButton" data-action="memo-sidebar#toggle" aria-expanded="true" aria-controls="memos_list_panel"]
              span.text-sm.leading-none.tabular-nums[aria-hidden="true" data-memo-sidebar-target="toggleGlyph"] ◀
              span.sr-only メモ一覧サイドバー
              span.hidden.md:inline[data-memo-sidebar-target="toggleLabel"] 折りたたむ
            .flex.min-h-0.flex-1.flex-col.overflow-hidden[data-memo-sidebar-target="body"]
              = render "memos/list_panel"
          .hidden.shrink-0.self-stretch.w-2.cursor-col-resize.bg-transparent.transition-colors.hover:bg-zinc-400.active:bg-zinc-500.md:block.z-10[role="separator" aria-orientation="vertical" aria-label="サイドバーの幅を変更" title="ドラッグして幅を変更" tabindex="-1" data-memo-sidebar-target="resizer" data-action="pointerdown->memo-sidebar#resizerPointerDown"]
          section[class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden"]
            div[class="flex-1 overflow-y-auto px-4 py-5 md:px-8"]
              = yield :memos_editor
      - else
        = yield

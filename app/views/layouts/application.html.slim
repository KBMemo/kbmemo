doctype html
html data-kb-theme="default" data-kb-theme-base="default"
  head
    title
      = content_for(:title) || "Kbmemo"
    meta[name="viewport" content="width=device-width,initial-scale=1"]
    meta[name="apple-mobile-web-app-capable" content="yes"]
    meta[name="application-name" content="Kbmemo"]
    meta[name="mobile-web-app-capable" content="yes"]
    = csrf_meta_tags
    = csp_meta_tag
    - if kb_theme_sync_enabled?
      meta name="kbmemo-theme-sync" content="true"
    = yield :head
    - # Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!)
    - #= tag.link rel: "manifest", href: pwa_manifest_path(format: :json)
    link[rel="icon" href="/icon.png" type="image/png"]
    link[rel="icon" href="/icon.svg" type="image/svg+xml"]
    link[rel="apple-touch-icon" href="/icon.png"]
    = vite_client_tag
    = vite_javascript_tag "application"
    script type="text/javascript"
      | window.__KBMEMO_ACCOUNT_THEME__ = #{raw kb_account_theme_json};
    script type="text/javascript"
      | (function(){try{var a=window.__KBMEMO_ACCOUNT_THEME__;if(a&&a.active_theme_id){localStorage.setItem("kbmemo_themes_v1",JSON.stringify({activeThemeId:a.active_theme_id,customThemes:(a.custom_themes||[]).map(function(t){return{id:t.id,label:t.label,baseTheme:t.base_theme,variables:t.variables||{},rules:t.rules||[]};}})}));}var r=localStorage.getItem("kbmemo_themes_v1");if(!r)return;var s=JSON.parse(r);if(!s.activeThemeId)return;document.documentElement.dataset.kbTheme=s.activeThemeId;var c=(s.customThemes||[]).find(function(t){return t.id===s.activeThemeId});document.documentElement.dataset.kbThemeBase=c&&c.baseTheme?c.baseTheme:s.activeThemeId;}catch(e){}})();
  body.kb-chrome-body.min-h-screen data-theme-slot="app-body" data-controller="flash-notice"
    header.kb-chrome-header data-theme-slot="app-header"
      nav.mx-auto.flex.w-full.flex-wrap.items-center.justify-between.gap-3.px-4.py-3 class=(wide_content_layout? ? "max-w-[1800px]" : "max-w-3xl")
        = link_to root_path, class: "kb-chrome-brand" do
          | Kbmemo
        .flex.flex-wrap.items-center.gap-x-4.gap-y-2.text-sm
          = link_to "メモ", memos_path, class: "kb-chrome-link"
          = link_to "カンバン", boards_path, class: "kb-chrome-link"
          = link_to "タグ管理", tags_path, class: "kb-chrome-link"
          = link_to "テーマ", theme_studio_path, class: "kb-chrome-link"
          - if rodauth.rails_account&.admin?
            = link_to "管理", admin_root_path, class: "kb-chrome-link"
          - if rodauth.rails_account
            .relative[data-controller="user-menu"]
              button.kb-input.inline-flex.max-w-56.items-center.gap-1.rounded-md.py-1.pl-2.pr-1.5.text-left.text-sm.font-medium.shadow-sm[type="button" data-user-menu-target="button" data-action="user-menu#toggle" aria-expanded="false" aria-haspopup="true" title=(rodauth.rails_account.email)]
                span.min-w-0.flex-1.truncate.kb-text-primary
                  = rodauth.rails_account.display_name
                svg.h-4.w-4.flex-shrink-0.kb-text-muted[xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"]
                  path[stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"]
              .kb-menu-panel.absolute.right-0.top-full.z-50.mt-1.hidden.min-w-48.rounded-md.py-1.text-sm[data-user-menu-target="panel" role="menu"]
                = link_to "プロフィール", edit_profile_path, class: "kb-menu-item block px-3 py-2", role: "menuitem"
                = link_to "パスワード変更", rodauth.change_password_path, class: "kb-menu-item block px-3 py-2", role: "menuitem"
                .px-3.py-2 role="none"
                  label.flex.items-center.justify-between.gap-3.kb-text-primary
                    span.kb-text-secondary テーマ
                    select.kb-input.rounded.px-1.5.py-0.5.text-sm data-theme-select="true" data-user-menu-target="themeSelect" data-action="change->user-menu#changeTheme" aria-label="表示テーマ"
                hr.my-1.border.kb-border
                = button_to "ログアウト", rodauth.logout_path, method: :post, form: { class: "block w-full" }, class: "kb-menu-item w-full rounded-none border-0 bg-transparent px-3 py-2 text-left text-sm font-normal", role: "menuitem"
          - if Rails.env.development?
            = link_to "送信メール", "/letter_opener", class: "kb-chrome-link kb-text-muted", target: "_blank", rel: "noopener"
          = link_to "新規メモ", new_memo_path_with_current_directory, class: "kb-chrome-btn-primary", data: { theme_slot: "btn-primary" }
    main.mx-auto.w-full.px-4 class=(wide_content_layout? ? "max-w-[1800px] py-6" : "max-w-3xl py-8")
      - if memos_wide_layout?
        div[class="hidden" aria-hidden="true"]
          = yield
        div class="kb-chrome-workspace flex -mx-4 flex-col border-t max-md:min-h-0 md:h-[calc(100vh-6.75rem)] md:max-h-[calc(100vh-6.75rem)] md:min-h-0 md:flex-row md:items-stretch md:overflow-hidden" data-controller="memo-sidebar" data-memo-sidebar-storage-key-value="kbmemo_memo_sidebar_v1"
          #memo_sidebar_shell.kb-chrome-panel[class="flex max-h-[min(42vh,360px)] max-md:w-full min-h-0 flex-shrink-0 flex-col border-b transition-[width,max-height] duration-200 ease-out md:max-h-none md:h-full md:flex-shrink-0 md:border-b-0 md:border-r md:border-t-0" data-theme-slot="memo-sidebar" data-memo-sidebar-target="shell"]
            button.kb-chrome-muted-bar.flex.w-full.shrink-0.items-center.justify-center.gap-2.border-b.px-2.py-2.text-left.text-xs.font-medium.md:hidden[type="button" data-memo-sidebar-target="toggleButtonMobile" data-action="memo-sidebar#toggle" aria-expanded="true" aria-controls="memos_list_panel"]
              span.text-sm.leading-none.tabular-nums[aria-hidden="true" data-memo-sidebar-target="toggleGlyphMobile"] ◀
              span.sr-only メモ一覧サイドバー
              span[data-memo-sidebar-target="toggleLabelMobile"] 折りたたむ
            .flex.min-h-0.flex-1.flex-col.overflow-hidden[data-memo-sidebar-target="body"]
              = render "memos/list_panel"
          button class=kb_sidebar_toggle_btn type="button" data-memo-sidebar-target="toggleButton" data-action="memo-sidebar#toggle" aria-expanded="true" aria-controls="memos_list_panel" title="メモ一覧サイドバーを折りたたむ"
            span.select-none.tracking-tighter[aria-hidden="true" data-memo-sidebar-target="toggleGlyph"] ««
            span.sr-only メモ一覧サイドバー
          div class=kb_resizer role="separator" aria-orientation="vertical" aria-label="サイドバーの幅を変更" title="ドラッグして幅を変更" tabindex="-1" data-memo-sidebar-target="resizer" data-action="pointerdown->memo-sidebar#resizerPointerDown"
          section[class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden"]
            div#memos_editor_scroll[class="flex-1 overflow-y-auto px-4 py-5 md:px-8"]
              = yield :memos_editor
          - if content_for?(:memo_ai_sidebar)
            div class="flex min-h-0 shrink-0 max-md:w-full max-md:max-h-[min(42vh,360px)] max-md:flex-col md:h-full md:max-h-full md:flex-row md:items-stretch md:overflow-hidden" data-controller="memo-ai-sidebar" data-memo-ai-sidebar-storage-key-value="kbmemo_memo_ai_sidebar_v1"
              button class=kb_sidebar_toggle_btn type="button" data-memo-ai-sidebar-target="toggleButton" data-action="memo-ai-sidebar#toggle" aria-expanded="true" aria-controls="memo_ai_sidebar_panel" title="AI パネルを折りたたむ"
                span.select-none.tracking-tighter[aria-hidden="true" data-memo-ai-sidebar-target="toggleGlyph"] »»
                span.sr-only AI パネル
              div class=kb_resizer role="separator" aria-orientation="vertical" aria-label="AI パネルの幅を変更" title="ドラッグして幅を変更" tabindex="-1" data-memo-ai-sidebar-target="resizer" data-action="pointerdown->memo-ai-sidebar#resizerPointerDown"
              #memo_ai_sidebar_shell.kb-chrome-panel[class="flex max-md:w-full min-h-0 flex-shrink-0 flex-col overflow-hidden border-t transition-[width,max-height] duration-200 ease-out md:max-h-full md:h-full md:border-t-0 md:border-l md:border-b-0" data-theme-slot="memo-sidebar" data-memo-ai-sidebar-target="shell"]
                button.kb-chrome-muted-bar.flex.w-full.shrink-0.items-center.justify-center.gap-2.border-b.px-2.py-2.text-left.text-xs.font-medium.md:hidden[type="button" data-memo-ai-sidebar-target="toggleButtonMobile" data-action="memo-ai-sidebar#toggle" aria-expanded="true" aria-controls="memo_ai_sidebar_panel"]
                  span.text-sm.leading-none.tabular-nums[aria-hidden="true" data-memo-ai-sidebar-target="toggleGlyphMobile"] »»
                  span.sr-only AI パネル
                  span[data-memo-ai-sidebar-target="toggleLabelMobile"] 折りたたむ
                .flex.min-h-0.flex-1.flex-col.overflow-hidden#memo_ai_sidebar_panel[data-memo-ai-sidebar-target="body"]
                  = yield :memo_ai_sidebar
      - else
        = yield
    = render "shared/flash_toasts"

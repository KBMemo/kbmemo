doctype html
html
  head
    title
      = content_for(:title) || "Kbmemo"
    meta[name="viewport" content="width=device-width,initial-scale=1"]
    meta[name="apple-mobile-web-app-capable" content="yes"]
    meta[name="application-name" content="Kbmemo"]
    meta[name="mobile-web-app-capable" content="yes"]
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    - # Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!)
    - #= tag.link rel: "manifest", href: pwa_manifest_path(format: :json)
    link[rel="icon" href="/icon.png" type="image/png"]
    link[rel="icon" href="/icon.svg" type="image/svg+xml"]
    link[rel="apple-touch-icon" href="/icon.png"]
    = vite_client_tag
    = vite_javascript_tag "application"
  body.min-h-screen.bg-zinc-50.text-zinc-900.antialiased
    header.border-b.border-zinc-200.bg-white
      nav.mx-auto.flex.w-full.flex-wrap.items-center.justify-between.gap-3.px-4.py-3 class=(memos_wide_layout? ? "max-w-[1800px]" : "max-w-3xl")
        = link_to root_path, class: "text-lg font-semibold tracking-tight text-zinc-900" do
          | Kbmemo
        .flex.items-center.gap-4.text-sm
          = link_to "メモ", memos_path, class: "text-zinc-600 hover:text-zinc-900"
          = link_to "タグ管理", tags_path, class: "text-zinc-600 hover:text-zinc-900"
          = link_to "新規メモ", new_memo_path_with_current_directory, class: "rounded-md bg-zinc-900 px-3 py-1.5 font-medium text-white hover:bg-zinc-800"
    main.mx-auto.w-full.px-4 class=(memos_wide_layout? ? "max-w-[1800px] py-6" : "max-w-3xl py-8")
      - flash.each do |level, message|
        - next if message.blank?
        - alert_classes = (level.to_sym == :notice) ? "border-emerald-200 bg-emerald-50 text-emerald-900" : "border-amber-200 bg-amber-50 text-amber-900"
        p.mb-4.rounded-md.border.px-3.py-2.text-sm class=alert_classes role="status"
          = message
      - if memos_wide_layout?
        div[class="hidden" aria-hidden="true"]
          = yield
        div[class="flex -mx-4 flex-col border-t border-zinc-200 bg-zinc-50 md:min-h-[calc(100vh-6.75rem)] md:flex-row md:items-stretch"]
          aside[class="flex max-h-[min(42vh,360px)] w-full flex-shrink-0 flex-col border-b border-zinc-200 bg-white md:max-h-none md:h-full md:w-80 md:max-w-[min(40vw,24rem)] md:flex-shrink-0 md:border-b-0 md:border-r md:border-t-0"]
            = render "memos/list_panel"
          section[class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden"]
            div[class="flex-1 overflow-y-auto px-4 py-5 md:px-8"]
              = yield :memos_editor
      - else
        = yield

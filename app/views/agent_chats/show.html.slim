- content_for :title, "AI チャット"

.agent-chat-page.mx-auto.flex.w-full.max-w-3xl.flex-col class="min-h-[calc(100dvh-10rem)]"
  header.mb-4.shrink-0
    h1.text-xl.font-semibold.kb-text-primary AI チャット
    p.mt-1.text-sm.kb-text-muted
      | intent 判定・RAG・ローカルモデルルーティングを使う汎用エージェントです。既定でローカル AI を使い、未起動時は登録済み OpenAI にフォールバックします。
    p.mt-2.text-sm
      = link_to "Chat サーバー設定", chat_server_path, class: "kb-chrome-link underline"
      span.mx-2.kb-text-muted ·
      = link_to "Nyoy MCP 設定", nyoy_mcp_path, class: "kb-chrome-link underline"

  .agent-chat-panel.kb-ai-panel.kb-chrome-panel.flex.min-h-0.flex-1.flex-col.overflow-hidden.rounded-lg.border.px-3.py-3 data-controller="agent-chat" data-agent-chat-chat-url-value=agent_chat_path(format: :json) data-agent-chat-settings-url-value=chat_server_path data-agent-chat-nyoy-tools-url-value=nyoy_tools_agent_chat_path(format: :json) data-agent-chat-nyoy-configured-value=(@nyoy_mcp_configured ? "true" : "false") data-agent-chat-conversation-id-value=(@conversation_id || "") aria-label="AI チャット"
    script type="application/json" data-agent-chat-target="initialMessagesJson"
      = raw (@initial_messages || []).to_json
    .kb-ai-messages.min-h-0.flex-1.overflow-y-auto.rounded-md.p-2 data-agent-chat-target="messages"
    p.hidden.shrink-0.text-xs.kb-status-danger data-agent-chat-target="error"
    details.kb-ai-chat-mcp-tools.shrink-0.mt-2 data-agent-chat-target="mcpToolsPanel"
      summary.kb-ai-chat-mcp-tools-summary.text-sm.kb-text-muted Nyoy MCP ツール
      .mt-2.space-y-2
        p.text-xs.kb-text-muted data-agent-chat-target="mcpToolsHint"
          - if @nyoy_mcp_configured
            | intent に応じて使う外部ツールを選びます。「ツール一覧を取得」で Nyoy MCP から読み込んでください。
          - else
            | Nyoy MCP が未設定です。
            = link_to "Nyoy MCP 設定", nyoy_mcp_path, class: "kb-chrome-link underline"
            | から URL と API トークンを保存してください。
        .flex.flex-wrap.gap-2
          button.kb-chrome-btn-secondary type="button" data-action="agent-chat#fetchNyoyTools" data-agent-chat-target="mcpToolsButton" ツール一覧を取得
        .hidden data-agent-chat-target="mcpToolsList"
    label.sr-only for="agent_chat_prompt" AI へのメッセージ
    textarea#agent_chat_prompt.kb-input.w-full.shrink-0.resize-none.font-sans.leading-relaxed rows=4 autocomplete="off" placeholder="例: メモを検索して RAG の設定を教えて（Ctrl+Enter で送信）" data-agent-chat-target="input" data-action="keydown->agent-chat#sendOnEnter"
    .mt-2.flex.shrink-0.flex-wrap.gap-2
      button.kb-chrome-btn-primary type="button" data-theme-slot="btn-primary" data-agent-chat-target="sendButton" data-action="agent-chat#send" 送信
      button.kb-toolbar-btn type="button" data-action="agent-chat#clearChat" 履歴を消去
